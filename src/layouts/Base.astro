---
import { ClientRouter } from 'astro:transitions';
import { GATE_STORAGE_KEY } from '../lib/gate';
import { withBase } from '../lib/url';
import { lastUpdated, formatDate } from '../lib/data';
import { t, type Lang } from '../i18n';
import SiteGuide from '../components/SiteGuide.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Adds " | STEM Pathways" to the title automatically. */
  raw?: boolean;
  /**
   * Make this page a valid target for the password page's logo transition.
   * The router is switched off again as soon as the page is up, so the rest
   * of the site keeps its normal page loads (see the script below).
   */
  gateTarget?: boolean;
  lang?: Lang;
}

const { title, description, raw = false, lang = 'en', gateTarget = false } = Astro.props;
const fullTitle = raw ? title : `${title} | STEM Pathways`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const updated = formatDate(lastUpdated(), lang);
// The how-to-browse popup opens itself on the home page only.
const homePath = withBase('/');
const isHome =
  Astro.url.pathname === homePath || Astro.url.pathname === homePath.replace(/\/$/, '');

// Strip the /es prefix (and base) to find the English twin of this page.
const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const strip = (p: string) => {
  let s = p.startsWith(base) ? p.slice(base.length) : p;
  s = s.replace(/^\/es(?=\/|$)/, '') || '/';
  return s.endsWith('/') || s === '' ? s : `${s}/`;
};
const plainPath = strip(Astro.url.pathname);
const enPath = withBase(plainPath);
const esPath = withBase(`/es${plainPath === '/' ? '' : plainPath}`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Password gate: without the unlock flag, go to /enter/ before anything
      paints. Not real access control - see src/lib/gate.ts.
    -->
    <script is:inline define:vars={{ key: GATE_STORAGE_KEY, gate: withBase('/enter/') }}>
      (function () {
        var unlocked = false;
        try {
          unlocked = localStorage.getItem(key) === '1';
        } catch (e) {}
        if (unlocked) return;
        document.documentElement.style.visibility = 'hidden';
        var next = location.pathname + location.search + location.hash;
        location.replace(gate + '?next=' + encodeURIComponent(next));
      })();
    </script>
    <noscript><style>body { display: none; }</style></noscript>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase("/s2s-logo.png")} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(esPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    {gateTarget && <ClientRouter />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase('/og-default.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b1220" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip', lang)}</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={withBase("/")}>          <img
            class="brand__mark"
            src={withBase("/s2s-logo.png")}
            alt=""
            width="1064"
            height="1233"
            decoding="async"
          />
          <span>STEM Pathways</span>
        </a>
        <nav class="nav" aria-label={t('nav.main', lang)}>
          <details class="nav__drop">
            <summary class="nav__label">{t('nav.states', lang)}</summary>
            <div class="nav__menu">
              <a href={withBase("/nj")}>New Jersey</a>
              <a href={withBase("/ny")}>New York</a>
              <a href={withBase("/pa")}>Pennsylvania</a>
              <a href={withBase("/compare")}>{t('nav.compareAll', lang)}</a>
            </div>
          </details>
          <details class="nav__drop">
            <summary class="nav__label">{t('nav.aboutS2S', lang)}</summary>
            <div class="nav__menu">
              <a href={withBase("/about")}>{t('nav.aboutUs', lang)}</a>
              <a href={withBase("/cap-program")}>{t('nav.cap', lang)}</a>
            </div>
          </details>
          <a href={withBase("/labs2life")}>{t('nav.labs2life', lang)}</a>
          <details class="nav__drop">
            <summary class="nav__label">{t('nav.more', lang)}</summary>
            <div class="nav__menu">
              <a href={withBase("/quiz")}>{t('nav.quiz', lang)}</a>
              <a href={withBase("/glossary")}>{t('nav.glossary', lang)}</a>
              <a href={withBase("/sources")}>{t('nav.sources', lang)}</a>
              <a href={withBase("/careers")}>{t('nav.browseCareers', lang)}</a>
            </div>
          </details>
          <details class="nav__drop">
            <summary class="nav__label" aria-label={t('nav.lang', lang)}>
              <span aria-hidden="true">🌐</span> {lang === 'es' ? 'ES' : 'EN'}
            </summary>
            <div class="nav__menu">
              <a href={enPath} lang="en" data-lang-link aria-current={lang === 'en' ? 'true' : undefined}>English</a>
              <a href={esPath} lang="es" data-lang-link aria-current={lang === 'es' ? 'true' : undefined}>Español</a>
            </div>
          </details>
          <a class="nav__explore" href={withBase("/explore")}>{t('home.ctaFinder', lang)}</a>
          <button
            type="button"
            class="nav__help"
            data-open-guide
            aria-label={t('nav.help', lang)}
            title={t('nav.help', lang)}
          >
            ?
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <h2>STEM Pathways</h2>
            <p>{t('footer.blurb', lang)}</p>
          </div>
          <div>
            <h2>{t('footer.explore', lang)}</h2>
            <ul>
              <li><a href={withBase("/labs2life")}>{t('footer.labs', lang)}</a></li>
              <li><a href={withBase("/about")}>{t('footer.about', lang)}</a></li>
              <li><a href={withBase("/cap-program")}>{t('footer.cap', lang)}</a></li>
            </ul>
          </div>
          <div>
            <h2>{t('footer.states', lang)}</h2>
            <ul>
              <li><a href={withBase("/nj")}>New Jersey</a></li>
              <li><a href={withBase("/ny")}>New York</a></li>
              <li><a href={withBase("/pa")}>Pennsylvania</a></li>
              <li><a href={withBase("/compare")}>{t('nav.compareAll', lang)}</a></li>
            </ul>
          </div>
          <div>
            <h2>{t('footer.learn', lang)}</h2>
            <ul>
              <li><a href={withBase("/labs2life")}>{t('footer.labs2', lang)}</a></li>
              <li><a href={withBase("/explore")}>{t('footer.exploreCareers', lang)}</a></li>
              <li><a href={withBase("/quiz")}>{t('footer.quiz', lang)}</a></li>
              <li><a href={withBase("/careers")}>{t('footer.careers', lang)}</a></li>
              <li><a href={withBase("/glossary")}>{t('footer.glossary', lang)}</a></li>
              <li><a href={withBase("/about")}>{t('footer.about', lang)}</a></li>
              <li><a href={withBase("/cap-program")}>{t('footer.cap2', lang)}</a></li>
              <li><a href={withBase("/sources")}>{t('footer.sources', lang)}</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-note">
          {t('footer.note', lang)}
          {updated && <> {t('footer.lastRun', lang)} {updated}.</>}
        </p>
      </div>
    </footer>

    <!-- The How to Browse This Site guide. It opens itself once, on the home page. -->
    <SiteGuide autoOpen={isHome} lang={lang} />
    {
      gateTarget && (
        <script is:inline>
          // The router is only here so the password page can animate into
          // this page. Turn it off now: every later link is a normal page load.
          document.querySelector('[name="astro-view-transitions-enabled"]')?.remove();
        </script>
      )
    }

    <script>
      // Dropdowns open on hover and close when the pointer leaves; taps and
      // keyboard presses still open them natively via details/summary.
      const drops = document.querySelectorAll<HTMLDetailsElement>('.nav__drop');
      drops.forEach((drop) => {
        drop.addEventListener('mouseenter', () => (drop.open = true));
        drop.addEventListener('mouseleave', () => (drop.open = false));
      });
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.nav__drop')) {
          drops.forEach((drop) => (drop.open = false));
        }
      });
    </script>
    {
      lang === 'es' && (
        <script is:inline define:vars={{ base: base || '' }}>
          // Spanish pages reuse the English components, whose links are
          // written for /. Rewrite every same-language internal link once, at
          // load, so navigation stays inside /es/. The language switcher links
          // carry data-lang-link and are left alone.
          const skip = /^\/es(\/|$)/;
          const isInternal = (p) =>
            p.startsWith('/') && !p.startsWith('//') && !skip.test(p) && !p.includes('.');
          document
            .querySelectorAll('a[href^="/"]:not([data-lang-link])')
            .forEach((a) => {
              const href = a.getAttribute('href');
              if (!href || !href.startsWith(base)) return;
              const rest = href.slice(base.length);
              if (isInternal(rest)) a.setAttribute('href', base + '/es' + rest);
            });
        </script>
      )
    }
  </body>
</html>