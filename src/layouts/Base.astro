---
import { withBase } from '../lib/url';
import { lastUpdated, formatDate } from '../lib/data';
import CareerFinder from '../components/CareerFinder.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Adds " | STEM Pathways" to the title automatically. */
  raw?: boolean;
}

const { title, description, raw = false } = Astro.props;
const fullTitle = raw ? title : `${title} | STEM Pathways`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const updated = formatDate(lastUpdated());
// The how-to-browse popup opens itself on the home page only.
const homePath = withBase('/');
const isHome =
  Astro.url.pathname === homePath || Astro.url.pathname === homePath.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase("/s2s-logo.png")} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase('/og-default.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b1220" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={withBase("/")}>          <img
            class="brand__mark"
            src={withBase("/s2s-logo.png")}
            alt=""
            width="1064"
            height="1233"
            decoding="async"
          />
          <span>STEM Pathways</span>
        </a>
        <nav class="nav" aria-label="Main">
          <details class="nav__drop">
            <summary class="nav__label">States</summary>
            <div class="nav__menu">
              <a href={withBase("/nj")}>New Jersey</a>
              <a href={withBase("/ny")}>New York</a>
              <a href={withBase("/pa")}>Pennsylvania</a>
              <a href={withBase("/compare")}>Compare all three</a>
            </div>
          </details>
          <details class="nav__drop">
            <summary class="nav__label">About S2S</summary>
            <div class="nav__menu">
              <a href={withBase("/about")}>About Us</a>
              <a href={withBase("/cap-program")}>CAP Program</a>
            </div>
          </details>
          <a href={withBase("/labs2life")}>Labs2Life</a>
          <details class="nav__drop">
            <summary class="nav__label">More</summary>
            <div class="nav__menu">
              <a href={withBase("/quiz")}>Quiz</a>
              <a href={withBase("/glossary")}>Glossary</a>
              <a href={withBase("/sources")}>Sources</a>
              <a href={withBase("/careers")}>Browse careers</a>
            </div>
          </details>
          <button
            type="button"
            class="nav__help"
            data-open-finder
            aria-label="How to browse this site"
            title="How to browse this site"
          >
            ?
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <h2>STEM Pathways</h2>
            <p>
              Real numbers about science, technology, engineering and math careers
              in New Jersey, New York and Pennsylvania — built for students who
              are figuring out what to do next.
            </p>
          </div>
          <div>
            <h2>Explore</h2>
            <ul>
              <li><a href={withBase("/labs2life")}>Labs2Life — labs to careers</a></li>
              <li><a href={withBase("/about")}>About Students 2 Science</a></li>
              <li><a href={withBase("/cap-program")}>Career Advancement Program (CAP)</a></li>
            </ul>
          </div>
          <div>
            <h2>States</h2>
            <ul>
              <li><a href={withBase("/nj")}>New Jersey</a></li>
              <li><a href={withBase("/ny")}>New York</a></li>
              <li><a href={withBase("/pa")}>Pennsylvania</a></li>
              <li><a href={withBase("/compare")}>Compare all three</a></li>
            </ul>
          </div>
          <div>
            <h2>Learn</h2>
            <ul>
              <li><a href={withBase("/labs2life")}>Labs2Life — from lab to career</a></li>
              <li><a href={withBase("/quiz")}>Guess the salary</a></li>
              <li><a href={withBase("/careers")}>Browse careers</a></li>
              <li><a href={withBase("/glossary")}>STEM words explained</a></li>
              <li><a href={withBase("/about")}>About Students 2 Science</a></li>
              <li><a href={withBase("/cap-program")}>Career Advancement Program</a></li>
              <li><a href={withBase("/sources")}>Where the data comes from</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-note">
          Every number on this site comes from an official government source and
          is labeled with its date. Nothing here is advice about your future —
          it is a starting point for exploring.
          {updated && <> Last data run: {updated}.</>}
        </p>
      </div>
    </footer>

    <!-- The How to Browse This Site popup. It opens itself once, on the home page. -->
    <CareerFinder autoOpen={isHome} />

    <script>
      // Dropdowns open on hover and close when the pointer leaves; taps and
      // keyboard presses still open them natively via details/summary.
      const drops = document.querySelectorAll<HTMLDetailsElement>('.nav__drop');
      drops.forEach((drop) => {
        drop.addEventListener('mouseenter', () => (drop.open = true));
        drop.addEventListener('mouseleave', () => (drop.open = false));
      });
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.nav__drop')) {
          drops.forEach((drop) => (drop.open = false));
        }
      });
    </script>
  </body>
</html>