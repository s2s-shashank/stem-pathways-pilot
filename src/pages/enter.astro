---
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';
import HeroScience from '../components/HeroScience.astro';
import {
  GATE_ITERATIONS,
  GATE_SALT,
  GATE_STORAGE_KEY,
  gatePasswordHash,
} from '../lib/gate';
import '../styles/global.css';

const hash = gatePasswordHash();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Enter password | STEM Pathways</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b1220" />
    <link rel="icon" type="image/png" href={withBase('/s2s-logo.png')} />
    <meta name="generator" content={Astro.generator} />
    <!--
      Only this page runs the router. It exists to animate the logo into the
      home page once; the home page does not enable it, so the rest of the
      site keeps its normal page loads.
    -->
    <ClientRouter />
  </head>
  <body>
    <main class="hero gate">
      <div class="wrap gate__inner">
        <div class="hero__logo-wrap">
          <HeroScience />
        </div>

        <form
          class="gate__form"
          data-gate-form
          data-hash={hash}
          data-salt={GATE_SALT}
          data-iterations={GATE_ITERATIONS}
          data-storage-key={GATE_STORAGE_KEY}
          data-home={withBase('/')}
          novalidate
        >
          <label class="gate__label" for="gate-password">Enter the password to continue</label>
          <div class="gate__row">
            <input
              id="gate-password"
              class="gate__input"
              type="password"
              name="password"
              autocomplete="current-password"
              autocapitalize="off"
              spellcheck="false"
              required
              autofocus
              aria-describedby="gate-error"
            />
            <button class="btn btn--sun gate__submit" type="submit">Enter</button>
          </div>
          <p id="gate-error" class="gate__error" role="alert" hidden></p>
        </form>

        <section class="gate__about" aria-labelledby="gate-about-title">
          <h1 id="gate-about-title" class="gate__title">STEM Pathways Pilot</h1>
          <p class="gate__kicker">by Students 2 Science</p>
          <p>
            Students 2 Science (S2S) is a New Jersey nonprofit that brings real science, real
            labs and real scientists to students, many of them from communities that have never
            had that chance.
          </p>
          <p>
            STEM Pathways is our pilot site: real numbers from official government sources on
            STEM jobs in New Jersey, New York and Pennsylvania. How many are open, what they pay,
            and what you would study to get one. The pilot is private while we test it.
          </p>
        </section>
      </div>
    </main>

    <script>
      import { navigate } from 'astro:transitions/client';

      const form = document.querySelector<HTMLFormElement>('[data-gate-form]')!;
      const input = form.querySelector<HTMLInputElement>('input')!;
      const submit = form.querySelector<HTMLButtonElement>('button')!;
      const error = form.querySelector<HTMLElement>('.gate__error')!;
      const { hash, salt, iterations, storageKey, home } = form.dataset as Record<string, string>;

      // Only follow ?next= to a page on this site, under the site's base path.
      const base = home.replace(/\/$/, '');
      function destination(): string {
        const next = new URLSearchParams(location.search).get('next');
        if (!next) return home;
        try {
          const url = new URL(next, location.origin);
          const inSite = url.origin === location.origin && url.pathname.startsWith(base + '/');
          const isGate = url.pathname.startsWith(base + '/enter');
          return inSite && !isGate ? url.pathname + url.search + url.hash : home;
        } catch {
          return home;
        }
      }

      // The logo glides into the hero on the home page. The home page's own
      // entrance animation would fight that, so it is switched off for this
      // one arrival.
      document.addEventListener('astro:before-swap', (e) => {
        e.newDocument.documentElement.setAttribute('data-from-gate', '');
      });

      function unlock(animate = false) {
        const go = () => navigate(destination(), { history: 'replace' });
        if (!animate || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          go();
          return;
        }
        // Let the gate play its exit before the logo glides to the home page.
        submit.disabled = true;
        input.readOnly = true;
        document.querySelector('.gate')!.classList.add('is-unlocking');
        // Replace, so the Back button does not land on the gate again.
        setTimeout(go, 450);
      }

      let unlocked = false;
      try {
        unlocked = localStorage.getItem(storageKey) === '1';
      } catch {
        // Storage blocked: the visitor has to enter the password.
      }
      if (unlocked) unlock();

      async function derive(password: string): Promise<string> {
        const enc = new TextEncoder();
        const key = await crypto.subtle.importKey('raw', enc.encode(password), 'PBKDF2', false, [
          'deriveBits',
        ]);
        const bits = await crypto.subtle.deriveBits(
          { name: 'PBKDF2', hash: 'SHA-256', salt: enc.encode(salt), iterations: Number(iterations) },
          key,
          256,
        );
        return Array.from(new Uint8Array(bits), (b) => b.toString(16).padStart(2, '0')).join('');
      }

      function showError(message: string) {
        error.textContent = message;
        error.hidden = false;
        // Restart the shake animation on repeated wrong guesses.
        form.classList.remove('is-wrong');
        void form.offsetWidth;
        form.classList.add('is-wrong');
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!input.value) {
          showError('Type the password first.');
          input.focus();
          return;
        }
        if (!window.crypto?.subtle) {
          showError('This browser cannot check passwords here. Open the site over https.');
          return;
        }
        submit.disabled = true;
        form.classList.add('is-checking');
        error.hidden = true;
        let ok = false;
        try {
          ok = (await derive(input.value)) === hash;
        } finally {
          submit.disabled = false;
          form.classList.remove('is-checking');
        }
        if (!ok) {
          showError('That password is not right. Try again.');
          input.select();
          return;
        }
        try {
          localStorage.setItem(storageKey, '1');
        } catch {
          // Storage blocked: this page view is let in, but the next page will ask again.
        }
        input.blur();
        unlock(true);
      });

      // Editing after a wrong guess clears the error styling.
      input.addEventListener('input', () => {
        form.classList.remove('is-wrong');
      });
    </script>
  </body>
</html>

<style is:global>
  .gate {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding-block: var(--space-l);
  }

  /* Slow drifting colour and stars behind the content. */
  .gate::before {
    content: '';
    position: absolute;
    inset: -20%;
    background:
      var(--hero-stars),
      radial-gradient(640px 420px at 28% 32%, rgb(64 164 236 / 20%), transparent 70%),
      radial-gradient(560px 400px at 74% 68%, rgb(31 111 106 / 32%), transparent 70%);
    background-size: var(--hero-stars-size), auto, auto;
    pointer-events: none;
    translate: calc(var(--px, 0) * -6px) calc(var(--py, 0) * -4px);
    transition: translate 0.6s ease-out;
    animation:
      gate-drift 20s ease-in-out infinite alternate,
      hero-twinkle 6s ease-in-out infinite alternate;
  }

  /* The logo reacts while you type. */
  .gate:has(.gate__input:focus) .hero__logo-wrap::before {
    filter: blur(20px) brightness(1.25);
  }

  .gate:has(.gate__input:focus) .hero__halo {
    opacity: 0.95;
  }

  .gate__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-l);
    width: 100%;
  }

  .gate__form {
    width: min(100%, 24rem);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.6rem;
    text-align: center;
    animation: gate-rise 0.8s 0.45s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .gate__label {
    font-weight: 700;
    color: #eaf0fb;
  }

  .gate__row {
    display: flex;
    gap: 0.5rem;
  }

  .gate__input {
    flex: 1;
    min-width: 0;
    padding: 0.7rem 1rem;
    font: inherit;
    color: #fff;
    background: rgb(255 255 255 / 10%);
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: var(--radius-pill);
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .gate__input:focus-visible {
    outline: 2px solid transparent;
    background: rgb(255 255 255 / 14%);
    border-color: rgb(169 228 255 / 85%);
    box-shadow:
      0 0 0 4px rgb(90 180 250 / 22%),
      0 0 28px rgb(90 180 250 / 28%);
  }

  .gate__form.is-wrong .gate__input {
    border-color: #ff9b8c;
    box-shadow: 0 0 0 4px rgb(255 140 120 / 22%);
  }

  .gate__submit {
    justify-content: center;
    min-width: 5.5rem;
  }

  .gate__submit:not(:disabled):hover {
    box-shadow: 0 8px 22px rgb(255 159 69 / 35%);
  }

  .gate__submit:not(:disabled):active {
    transform: translateY(1px);
  }

  .gate__submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .gate__form.is-checking .gate__submit::after {
    content: '';
    width: 0.9em;
    height: 0.9em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: gate-spin 0.7s linear infinite;
  }

  .gate__about {
    max-width: 34rem;
    text-align: center;
    color: #c4d0e6;
    animation: gate-rise 0.8s 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .gate__about p {
    margin: 0 0 0.75rem;
  }

  .gate__title {
    margin: 0 auto;
    max-width: none;
    font-size: var(--step-2);
    color: #fff;
  }

  .gate__kicker {
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: #a9e4ff;
    margin-bottom: 1rem !important;
  }

  .gate__error {
    margin: 0;
    color: #ffb4a8;
    font-weight: 600;
  }

  .gate__error:not([hidden]) {
    animation: gate-rise 0.3s ease backwards;
  }

  .gate__form.is-wrong .gate__row {
    animation: gate-shake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }

  /* Correct password: the form fades away and the logo swells before it glides home. */
  .gate.is-unlocking .gate__form,
  .gate.is-unlocking .gate__about {
    animation: gate-leave 0.4s ease forwards;
  }

  .gate.is-unlocking .hero__logo {
    animation: gate-unlock 0.45s ease-out forwards;
  }

  /* The icons and rings burst outward and the halo spins up. */
  .gate.is-unlocking .hero__logo-wrap .hero__decor-item {
    scale: 2.4;
    opacity: 0;
    transition:
      scale 0.45s ease-in,
      opacity 0.4s ease-in;
  }

  .gate.is-unlocking .hero__logo-wrap .hero__ring {
    scale: 1.35;
    opacity: 0;
    transition:
      scale 0.45s ease-in,
      opacity 0.4s ease-in;
  }

  .gate.is-unlocking .hero__logo-wrap .hero__halo {
    opacity: 1;
    animation-duration: 1.2s, 0.9s;
  }

  @keyframes gate-drift {
    to {
      transform: translate3d(4%, 3%, 0) scale(1.08);
    }
  }

  @keyframes gate-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @keyframes gate-leave {
    to {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  @keyframes gate-unlock {
    to {
      transform: scale(1.08);
    }
  }

  @keyframes gate-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes gate-shake {
    15% {
      transform: translateX(-8px);
    }
    30% {
      transform: translateX(7px);
    }
    45% {
      transform: translateX(-5px);
    }
    60% {
      transform: translateX(3px);
    }
    75% {
      transform: translateX(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gate::before,
    .gate__form,
    .gate__about,
    .gate__error:not([hidden]),
    .gate__form.is-wrong .gate__row,
    .gate__form.is-checking .gate__submit::after {
      animation: none;
    }
  }
</style>
