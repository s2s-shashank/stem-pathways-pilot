---
import { withBase } from '../lib/url';
import Base from '../layouts/Base.astro';
import { allStateData } from '../lib/data';
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

interface QuizItem {
  soc: string;
  title: string;
  median: number;
  category: string;
}

// Use the most common jobs, so students recognise them, then shuffle.
// Only use jobs common enough that a student may have heard of them.
const common = new Map<string, QuizItem>();
for (const state of allStateData()) {
  for (const o of state.occupations) {
    if (o.employment >= 2000 && !common.has(o.soc)) {
      common.set(o.soc, {
        soc: o.soc,
        title: o.title,
        median: o.medianWage,
        category: o.category,
      });
    }
  }
}
const pool = [...common.values()].sort((a, b) => b.median - a.median);
// Take a spread from the top earners down to the mid-range, so each round has
// one clear winner but not always the same kind of job.
const step = Math.max(3, Math.floor(pool.length / 15));
const items: QuizItem[] = [];
for (let i = 0; i < pool.length && items.length < 15; i += step) {
  items.push(pool[i]);
}
const questions = [];
for (let i = 0; i + 2 < items.length && questions.length < 5; i += 3) {
  const trio = items.slice(i, i + 3);
  const best = [...trio].sort((a, b) => b.median - a.median)[0];
  const shuffled = [...trio].sort(() => Math.random() - 0.5);
  questions.push({ trio: shuffled, best: best.soc });
}
---

<Base
  title={t('quiz.h1', lang)}
  description={lang === 'es'
    ? 'Una prueba rápida: ¿qué carrera STEM paga más? Pon a prueba tu instinto con datos salariales reales.'
    : 'A quick quiz: which STEM career pays the most? Test your instincts with real salary data.'}
  lang={lang}
>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag"><span aria-hidden="true">●</span> {t('quiz.tag', lang)}</span>
      <h1>{t('quiz.h1', lang)}</h1>
      <p class="lede">{t('quiz.lede', lang)}</p>
      <p class="small muted">{t('quiz.small', lang)}</p>
      {lang === 'es' && <p class="stamp">{t('es.notice', lang)}</p>}
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap--narrow">
      {
        questions.length === 0 ? (
          <p class="lede">{t('quiz.loading', lang)}</p>
        ) : (
          <div class="quiz" id="quiz" data-lang={lang}>
            <div class="quiz__progress" aria-hidden="true">
              <span class="quiz__progress-fill" id="q-fill" />
            </div>

            <div class="quiz__top">
              <span class="quiz__count">
                {t('quiz.question', lang)} <strong id="q-num">1</strong> {t('quiz.of', lang)} {questions.length}
              </span>
              <span class="quiz__score">
                {t('quiz.score', lang)} <strong id="q-score">0</strong>
              </span>
            </div>

            <p class="quiz__ask" id="q-ask">{t('quiz.ask', lang)}</p>
            <div class="quiz__options" id="q-options"></div>
            <p class="quiz__feedback" id="q-feedback" role="status" aria-live="polite" />

            <div class="quiz__final" id="q-final" hidden>
              <div class="quiz__final-body">
                <p class="quiz__final-kicker">{t('quiz.result', lang)}</p>
                <p class="quiz__final-text" id="q-final-text" />
              </div>
              <a class="btn btn--primary" href={withBase("/quiz")}>{t('quiz.again', lang)}</a>
            </div>
          </div>
        )
      }
    </div>
  </section>
</Base>

{
  questions.length > 0 && (
    <script is:inline type="application/json" id="quiz-data" set:html={JSON.stringify(questions)} />
  )
}

<script>
  const root = document.getElementById('quiz');
  const dataEl = document.getElementById('quiz-data');
  if (root && dataEl) {
    const es = (root as HTMLElement).dataset.lang === 'es';
    const questions = JSON.parse(dataEl.textContent || '[]');
    const LETTERS = ['A', 'B', 'C'];
    let index = 0;
    let score = 0;

    const numEl = document.getElementById('q-num')!;
    const scoreEl = document.getElementById('q-score')!;
    const fillEl = document.getElementById('q-fill')!;
    const optionsEl = document.getElementById('q-options')!;
    const feedbackEl = document.getElementById('q-feedback')!;
    const finalEl = document.getElementById('q-final')!;
    const finalText = document.getElementById('q-final-text')!;

    const money = (n: number) =>
      '$' + Math.round(n).toLocaleString('en-US');

    function render() {
      const q = questions[index];
      numEl.textContent = String(index + 1);
      scoreEl.textContent = String(score);
      fillEl.style.width = `${((index + 1) / questions.length) * 100}%`;
      feedbackEl.textContent = '';
      feedbackEl.className = 'quiz__feedback';
      optionsEl.innerHTML = '';

      q.trio.forEach((item: any, i: number) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'quiz__option';
        btn.dataset.soc = item.soc;

        const key = document.createElement('span');
        key.className = 'quiz__key';
        key.setAttribute('aria-hidden', 'true');
        key.textContent = LETTERS[i] ?? String(i + 1);

        const name = document.createElement('span');
        name.className = 'quiz__name';
        name.textContent = item.title;

        const pay = document.createElement('span');
        pay.className = 'quiz__pay';
        pay.textContent = money(item.median);

        const mark = document.createElement('span');
        mark.className = 'quiz__mark';
        mark.setAttribute('aria-hidden', 'true');

        btn.append(key, name, pay, mark);
        btn.addEventListener('click', () => answer(btn, item, q));
        optionsEl.appendChild(btn);
      });
    }

    function answer(btn: HTMLButtonElement, item: any, q: any) {
      const buttons = Array.from(
        optionsEl.querySelectorAll<HTMLButtonElement>('.quiz__option'),
      );
      buttons.forEach((b) => {
        b.disabled = true;
        b.classList.add('is-revealed');
      });

      const best = q.trio.find((t: any) => t.soc === q.best);
      const correct = item.soc === q.best;

      for (const b of buttons) {
        if (b.dataset.soc === q.best) {
          b.classList.add('is-correct');
          b.querySelector('.quiz__mark')!.textContent = '✓';
        }
      }

      if (correct) {
        score += 1;
        feedbackEl.classList.add('is-good');
        feedbackEl.textContent = es
          ? `¡Correcto! El salario del medio de ${item.title} es ${money(item.median)} al año.`
          : `Correct! The middle salary for ${item.title} is ${money(item.median)} a year.`;
      } else {
        btn.classList.add('is-wrong');
        btn.querySelector('.quiz__mark')!.textContent = '✕';
        feedbackEl.classList.add('is-bad');
        feedbackEl.textContent = es
          ? `Casi. El salario del medio de ${best.title} es ${money(best.median)} al año: ${money(best.median - item.median)} más.`
          : `Not quite. The middle salary for ${best.title} is ${money(best.median)} a year — ${money(best.median - item.median)} more.`;
      }

      scoreEl.textContent = String(score);
      setTimeout(() => {
        index += 1;
        if (index >= questions.length) {
          const msg =
            score === questions.length
              ? es
                ? 'Puntuación perfecta. Realmente conoces los salarios STEM.'
                : 'Perfect score. You really know your STEM salaries.'
              : score >= questions.length - 1
                ? es
                  ? '¡Casi! ¿Otra ronda?'
                  : 'So close! One more round?'
                : es
                  ? 'Buen intento: ahora sabes más que antes.'
                  : 'Nice try — now you know more than you did before.';
          finalText.textContent = es
            ? `Sacaste ${score} de ${questions.length}. ${msg}`
            : `You scored ${score} out of ${questions.length}. ${msg}`;
          finalEl.hidden = false;
          optionsEl.innerHTML = '';
          feedbackEl.className = 'quiz__feedback';
        } else {
          render();
        }
      }, 2600);
    }

    // Keys 1, 2 and 3 pick an option, so you can play without the mouse.
    document.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const tag = (document.activeElement?.tagName ?? '').toLowerCase();
      if (tag === 'input' || tag === 'textarea' || tag === 'select') return;
      const i = ['1', '2', '3'].indexOf(e.key);
      if (i < 0) return;
      const btn = optionsEl.querySelectorAll<HTMLButtonElement>(
        '.quiz__option',
      )[i];
      if (btn && !btn.disabled) btn.click();
    });

    render();
  }
</script>

<!-- is:global: the option buttons are built in JS, so Astro's scoped
     style attribute never lands on them and scoped rules would not match. -->
<style is:global>
  .quiz {
    position: relative;
    overflow: hidden;
    background: var(--paper);
    border: var(--border);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-m);
    padding: var(--space-l);
  }

  .quiz__progress {
    position: absolute;
    inset: 0 0 auto 0;
    height: 5px;
    background: var(--paper-sunk);
  }

  .quiz__progress-fill {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--c-computing), var(--c-data));
    transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .quiz__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-m);
  }

  .quiz__count {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-500);
  }

  .quiz__count strong {
    color: var(--ink-900);
  }

  .quiz__score {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .quiz__score strong {
    font-size: var(--step-0);
    font-weight: 850;
    font-variant-numeric: tabular-nums;
  }

  .quiz__ask {
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-m);
  }

  .quiz__options {
    display: grid;
    gap: var(--space-2xs);
  }

  .quiz__option {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-align: left;
    font: inherit;
    font-weight: 650;
    padding: 0.9rem 1.05rem;
    border-radius: var(--radius-m);
    border: 1.5px solid var(--paper-sunk);
    background: var(--paper);
    color: var(--ink-900);
    cursor: pointer;
    box-shadow: var(--shadow-s);
    transition: transform 0.15s ease, border-color 0.15s ease,
      box-shadow 0.15s ease, background 0.15s ease;
    animation: quiz-in 0.3s ease backwards;
  }

  .quiz__option:nth-child(2) {
    animation-delay: 0.06s;
  }

  .quiz__option:nth-child(3) {
    animation-delay: 0.12s;
  }

  .quiz__option:hover:not(:disabled) {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-m);
  }

  .quiz__option:disabled {
    cursor: default;
  }

  .quiz__key {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--paper-sunk);
    background: var(--paper-alt);
    color: var(--ink-500);
    font-size: var(--step--1);
    font-weight: 800;
    transition: background 0.15s ease, color 0.15s ease,
      border-color 0.15s ease;
  }

  .quiz__option:hover:not(:disabled) .quiz__key {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .quiz__name {
    flex: 1;
    min-width: 0;
  }

  .quiz__pay {
    flex: none;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--ink-700);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .quiz__option.is-revealed .quiz__pay {
    opacity: 1;
    transform: none;
  }

  .quiz__mark {
    flex: none;
    width: 1.35rem;
    text-align: center;
    font-weight: 900;
  }

  .quiz__option.is-correct {
    border-color: var(--good);
    background: color-mix(in srgb, var(--good) 10%, transparent);
  }

  .quiz__option.is-correct .quiz__mark {
    color: var(--good);
  }

  .quiz__option.is-wrong {
    border-color: var(--bad);
    background: color-mix(in srgb, var(--bad) 10%, transparent);
  }

  .quiz__option.is-wrong .quiz__mark {
    color: var(--bad);
  }

  .quiz__feedback {
    margin: var(--space-s) 0 0;
    padding: var(--space-s);
    border-radius: var(--radius-m);
    font-weight: 650;
    border-left: 4px solid transparent;
    background: var(--paper-alt);
    color: var(--ink-900);
  }

  .quiz__feedback:empty {
    padding: 0;
    margin: 0;
    background: none;
  }

  .quiz__feedback.is-good {
    border-left-color: var(--good);
    background: color-mix(in srgb, var(--good) 10%, transparent);
  }

  .quiz__feedback.is-bad {
    border-left-color: var(--bad);
    background: color-mix(in srgb, var(--bad) 8%, transparent);
  }

  /* display:flex above would otherwise beat the hidden attribute. */
  .quiz__final[hidden] {
    display: none;
  }

  .quiz__final {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: var(--space-m);
    padding: var(--space-m);
    border-radius: var(--radius-m);
    background: var(--paper-alt);
    border: var(--border);
  }

  .quiz__final-kicker {
    margin: 0 0 0.15rem;
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .quiz__final-text {
    margin: 0;
    font-weight: 650;
  }

  @keyframes quiz-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (max-width: 480px) {
    .quiz {
      padding: var(--space-m);
    }
    /* Stack the salary under the job name, key on the left, tick on the right. */
    .quiz__option {
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'key name mark'
        'key pay mark';
      align-items: center;
      column-gap: 0.8rem;
      row-gap: 0.1rem;
    }
    .quiz__key {
      grid-area: key;
    }
    .quiz__name {
      grid-area: name;
    }
    .quiz__pay {
      grid-area: pay;
      transform: none;
    }
    .quiz__mark {
      grid-area: mark;
    }
  }
</style>
