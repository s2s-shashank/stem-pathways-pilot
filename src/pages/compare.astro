---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import { STATES } from '../data/states';
import {
  getStateData,
  formatNumber,
  formatMoney,
  formatDate,
  allStateData,
} from '../lib/data';
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const rows = STATES.map((s) => {
  const d = getStateData(s.code);
  const occ = d?.occupations ?? [];
  const total = occ.reduce((sum, o) => sum + o.employment, 0);
  const wages = occ.map((o) => o.medianWage).sort((a, b) => a - b);
  return {
    state: s,
    data: d,
    open: d?.live.total,
    privateOpen: d?.live.private?.total,
    employment: total,
    median: wages.length ? wages[Math.floor(wages.length / 2)] : undefined,
  };
});

const ready = rows.filter((r) => r.data);

const title =
  lang === 'es'
    ? 'Compara Nueva Jersey, Nueva York y Pensilvania'
    : 'Compare New Jersey, New York and Pennsylvania';
const description =
  lang === 'es'
    ? 'Cifras de empleos STEM una al lado de la otra para Nueva Jersey, Nueva York y Pensilvania: gente trabajando, vacantes, salarios y cómo leerlas.'
    : 'STEM job numbers side by side for New Jersey, New York and Pennsylvania: people working, jobs open, salaries and how to read them.';
---

<Base title={title} description={description} lang={lang}>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag"><span aria-hidden="true">●</span> {t('cmp.tag', lang)}</span>
      <h1>{t('cmp.h1', lang)}</h1>
      <p class="lede">{t('cmp.lede', lang)}</p>
      {lang === 'es' && <p class="stamp">{t('es.notice', lang)}</p>}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {
        ready.length === 0 ? (
          <div class="wrap--narrow">
            <h2>{t('cmp.empty.h2', lang)}</h2>
            <p class="lede">{t('cmp.empty.p', lang)}</p>
          </div>
        ) : (
          <>
            <div class="table-wrap">
              <table>
                <caption class="sr-only">{t('cmp.caption', lang)}</caption>
                <thead>
                  <tr>
                    <th scope="col">{t('cmp.col', lang)}</th>
                    {rows.map((r) => (
                      <th scope="col" class="num">
                        {r.state.short}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th scope="row">{t('cmp.row1', lang)}</th>
                    {rows.map((r) => (
                      <td class="num">{formatNumber(r.employment)}</td>
                    ))}
                  </tr>
                  <tr>
                    <th scope="row">{t('cmp.row2', lang)}</th>
                    {rows.map((r) => (
                      <td class="num">{formatNumber(r.privateOpen)}</td>
                    ))}
                  </tr>
                  <tr>
                    <th scope="row">{t('cmp.row3', lang)}</th>
                    {rows.map((r) => (
                      <td class="num">{formatNumber(r.open)}</td>
                    ))}
                  </tr>
                  <tr>
                    <th scope="row">{t('cmp.row4', lang)}</th>
                    {rows.map((r) => (
                      <td class="num">{formatMoney(r.median)}</td>
                    ))}
                  </tr>
                  <tr>
                    <th scope="row">{t('cmp.row5', lang)}</th>
                    {rows.map((r) => (
                      <td class="num small muted">{formatDate(r.data?.asOf, lang)}</td>
                    ))}
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="source-note">{t('cmp.note', lang)}</p>
          </>
        )
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{t('cmp.read.eyebrow', lang)}</span>
        <h2>{t('cmp.read.h2', lang)}</h2>
        <p class="lede">{t('cmp.read.lede', lang)}</p>
      </div>
      <div class="grid grid--3">
        <article class="card card--flat">
          <h3 class="card__title">{t('cmp.card1.h3', lang)}</h3>
          <p class="muted">{t('cmp.card1.p', lang)}</p>
        </article>
        <article class="card card--flat">
          <h3 class="card__title">{t('cmp.card2.h3', lang)}</h3>
          <p class="muted">{t('cmp.card2.p', lang)}</p>
        </article>
        <article class="card card--flat">
          <h3 class="card__title">{t('cmp.card3.h3', lang)}</h3>
          <p class="muted">{t('cmp.card3.p', lang)}</p>
        </article>
      </div>
      <p class="source-note">
        {t('cmp.glossary1', lang)} <a href={withBase('/glossary')}>{t('cmp.glossary2', lang)}</a>
      </p>
    </div>
  </section>
</Base>
