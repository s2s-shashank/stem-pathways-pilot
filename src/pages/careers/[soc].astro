---
import Base from '../../layouts/Base.astro';
import Bars from '../../components/Bars.astro';
import PayTranslation from '../../components/PayTranslation.astro';
import Explain from '../../components/Explain.astro';
import { withBase } from '../../lib/url';
import {
  allStateData,
  formatMoney,
  formatNumber,
  formatDate,
  formatGrowth,
} from '../../lib/data';
import { describe } from '../../lib/descriptions';
import { CATEGORY_MAP, STATES } from '../../data/states';
import { t, CATEGORY_LABELS_ES, type Lang } from '../../i18n';

interface Props {
  soc: string;
  lang?: Lang;
}

export async function getStaticPaths() {
  const socs = new Set<string>();
  for (const state of allStateData()) {
    for (const o of state.occupations) socs.add(o.soc);
  }
  return [...socs].map((soc) => ({ params: { soc }, props: { soc } }));
}

const { soc, lang = 'en' } = Astro.props;

const perState = STATES.map((s) => {
  const data = allStateData().find((d) => d.state === s.code);
  const occ = data?.occupations.find((o) => o.soc === soc);
  return { state: s, occ, data };
}).filter((r) => r.occ);

if (perState.length === 0) {
  return Astro.redirect(lang === 'es' ? '/es/careers' : '/careers');
}

const primary = perState[0].occ!;
const title = primary.title;
const category = CATEGORY_MAP[primary.category];
const catName = category
  ? lang === 'es'
    ? (CATEGORY_LABELS_ES[category.id] ?? category.label)
    : category.label
  : 'STEM';
const job = describe(soc, primary.category);
const bestPay = perState.reduce((best, row) =>
  (row.occ!.medianWage ?? 0) > (best.occ!.medianWage ?? 0) ? row : best,
);

// Private-sector postings for this exact occupation, per state.
const openings = perState.map((row) => ({
  state: row.state,
  count: row.data?.live.private?.occupationCounts?.[soc] ?? 0,
}));

// Where the people who already do this job work, in the biggest state.
const busiest = perState.reduce((best, row) =>
  (row.occ!.employment ?? 0) > (best.occ!.employment ?? 0) ? row : best,
);
---

<Base
  title={`${title}: ${t('cd.titleSuffix', lang)}`}
  description={t('cd.description', lang, { title })}
  lang={lang}
>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag">
        <span aria-hidden="true">{category?.icon ?? '⚗️'}</span> {catName}
      </span>
      <h1>{title}</h1>
      <p class="lede">{job.what}</p>
      {lang === 'es' && <p class="stamp">{t('es.notice', lang)}</p>}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid--2 job-intro">
        <article class="card card--flat">
          <h2 class="card__title">{t('cd.day', lang)}</h2>
          <p class="muted">{job.day}</p>
        </article>
        <article class="card card--flat">
          <h2 class="card__title">{t('cd.study', lang)}</h2>
          <p class="muted">{job.school}</p>
          <p class="source-note">
            {primary.education
              ? t('cd.education', lang, {
                  education: `${primary.education.charAt(0).toLowerCase()}${primary.education.slice(1)}`,
                })
              : t('cd.educationNone', lang)}
          </p>
        </article>
      </div>

      <h2 class="section-title">{t('cd.numbers', lang)}</h2>
      <div class="table-wrap">
        <table>
          <caption class="sr-only">{t('cd.caption', lang, { title })}</caption>
          <thead>
            <tr>
              <th scope="col">{t('cd.colState', lang)}</th>
              <th scope="col" class="num">{t('cd.colPeople', lang)}</th>
              <th scope="col" class="num">{t('cd.colMedian', lang)}</th>
              <th scope="col" class="num">{t('cd.colEntry', lang)}</th>
              <th scope="col" class="num">{t('cd.colOpen', lang)}</th>
              <th scope="col" class="num">{t('cd.colGrowth', lang)}</th>
            </tr>
          </thead>
          <tbody>
            {
              perState.map(({ state, occ }) => (
                <tr>
                  <th scope="row">
                    <a href={withBase(`/${state.code}`)}>{state.name}</a>
                  </th>
                  <td class="num">{formatNumber(occ!.employment)}</td>
                  <td class="num">{formatMoney(occ!.medianWage)}</td>
                  <td class="num">{formatMoney(occ!.entryWage)}</td>
                  <td class="num">
                    {formatNumber(
                      openings.find((o) => o.state.code === state.code)?.count,
                    )}
                  </td>
                  <td class="num">{formatGrowth(occ!.growth)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="source-note table-note">
          <strong>{t('cd.colMedian', lang)}</strong> {t('cd.median1', lang)}
          <Explain
            label="?"
            text={t('cd.medianExplain', lang)}
            lang={lang}
          />
          <br />
          <strong>{t('cd.colOpen', lang)}</strong> {t('cd.open1', lang)}
          <Explain
            label="?"
            text={t('cd.openExplain', lang)}
            lang={lang}
          />
          <br />
          <strong>{t('cd.colGrowth', lang)}</strong> {t('cd.growth1', lang)}
        </p>
      </div>

      <div class="grid grid--2 two-col">
        <div>
          <h2 class="section-title">{t('cd.feels', lang)}</h2>
          <PayTranslation annual={bestPay.occ!.medianWage} lang={lang} />
          <p class="source-note">
            {t('cd.feels.note', lang, { state: bestPay.state.name })}
          </p>
        </div>
        <div>
          <h2 class="section-title">{t('cd.highest', lang)}</h2>
          <div class="card">
            <Bars
              items={perState.map((row) => ({
                label: row.state.name,
                value: row.occ!.medianWage ?? 0,
                color: row.state.color,
              }))}
              label={t('cd.highest.label', lang, { title })}
              format="currency"
            />
          </div>
        </div>
      </div>

      <div class="grid grid--2 two-col">
        <article class="card card--flat">
          <h2 class="card__title">{t('cd.howmany', lang)}</h2>
          <p class="muted">
            {t('cd.howmany.p', lang, {
              state: busiest.state.name,
              count: formatNumber(busiest.occ!.employment),
              job: title.toLowerCase(),
              total: formatNumber(
                perState.reduce((sum, row) => sum + (row.occ!.employment ?? 0), 0),
              ),
            })}
          </p>
        </article>

        <article class="card card--flat">
          <h2 class="card__title">{t('cd.questions', lang)}</h2>
          <ul class="muted">
            <li>{t('cd.q1', lang)}</li>
            <li>{t('cd.q2', lang)}</li>
            <li>{t('cd.q3', lang)}</li>
            <li>{t('cd.q4', lang)}</li>
          </ul>
        </article>
      </div>

      <p class="source-note final-note">
        {t('cd.dataAsOf', lang)} {formatDate(perState[0].data?.asOf, lang)}.{' '}
        {t('cd.bls', lang)} <a href={withBase('/sources')}>{t('cd.sources', lang)}</a>
        · <a href={withBase('/glossary')}>{t('cd.glossary', lang)}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .job-intro {
    margin-bottom: var(--space-xl);
  }
  .section-title {
    font-size: var(--step-2);
    margin-bottom: var(--space-s);
  }
  .two-col {
    margin-top: var(--space-l);
    align-items: start;
  }
  .table-note {
    margin: 0;
    padding: 0.8rem 1rem;
    border-top: 1px solid var(--paper-sunk);
    line-height: 1.7;
  }
  .final-note {
    margin-top: var(--space-xl);
  }
</style>
