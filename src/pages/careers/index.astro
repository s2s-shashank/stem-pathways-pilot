---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';
import { allStateData, formatMoney, formatNumber, formatGrowth } from '../../lib/data';
import { CATEGORIES, STATES } from '../../data/states';
import { describe } from '../../lib/descriptions';
import { t, CATEGORY_LABELS_ES, type Lang } from '../../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const catLabel = (id: string, en: string) =>
  lang === 'es' ? (CATEGORY_LABELS_ES[id] ?? en) : en;

interface Career {
  soc: string;
  title: string;
  category: string;
  employment: number;
  /** One wage per state that reports one, so we can average them. */
  medianWages: number[];
  meanWages: number[];
  entryWages: number[];
  growth?: number;
}

const careers = new Map<string, Career>();
for (const state of allStateData()) {
  for (const o of state.occupations) {
    let career = careers.get(o.soc);
    if (!career) {
      career = {
        soc: o.soc,
        title: o.title,
        category: o.category,
        employment: 0,
        medianWages: [],
        meanWages: [],
        entryWages: [],
      };
      careers.set(o.soc, career);
    }
    career.employment += o.employment;
    if (o.medianWage > 0) career.medianWages.push(o.medianWage);
    if (o.meanWage > 0) career.meanWages.push(o.meanWage);
    if (o.entryWage > 0) career.entryWages.push(o.entryWage);
    career.growth ??= o.growth;
  }
}

/** The average wage across the states that report one. */
function average(values: number[]): number {
  if (!values.length) return 0;
  return Math.round(values.reduce((sum, v) => sum + v, 0) / values.length);
}

const list = [...careers.values()]
  .map((c) => ({
    soc: c.soc,
    title: c.title,
    category: c.category,
    employment: c.employment,
    meanWage: average(c.meanWages),
    medianWage: average(c.medianWages),
    entryWage: average(c.entryWages),
    growth: c.growth,
  }))
  .sort((a, b) => b.employment - a.employment);

const groups = CATEGORIES.map((c) => ({
  category: c,
  items: list.filter((x) => x.category === c.id),
})).filter((g) => g.items.length > 0);
---

<Base
  title={lang === 'es' ? 'Carreras STEM' : 'STEM careers'}
  description={lang === 'es'
    ? 'Todas las carreras STEM que seguimos, con qué implica el trabajo, cuánta gente lo hace, cuánto paga y si está creciendo.'
    : 'Every STEM career we track, with what the job involves, how many people do it, what it pays and whether it is growing.'}
  lang={lang}
>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag"><span aria-hidden="true">●</span> {t('ci.tag', lang)}</span>
      <h1>{t('ci.h1', lang)}</h1>
      <p class="lede">{t('ci.lede', lang, { count: list.length })}</p>
      {lang === 'es' && <p class="stamp">{t('es.notice', lang)}</p>}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="search-box">
        <label for="career-search">{t('ci.search', lang)}</label>
        <input
          type="search"
          id="career-search"
          placeholder={t('ci.placeholder', lang)}
          autocomplete="off"
          data-lang={lang}
        />
        <p class="search-note" id="search-note" data-total={list.length}>
          {t('ci.note', lang, { count: list.length })}
        </p>
      </div>

      {
        groups.length === 0 ? (
          <p class="lede">{t('ci.loading', lang)}</p>
        ) : (
          groups.map((g) => (
            <section class="cat-section" data-category={catLabel(g.category.id, g.category.label)}>
              <h2>
                <span aria-hidden="true">{g.category.icon}</span>{' '}
                {catLabel(g.category.id, g.category.label)}
                <span class="cat-count">{g.items.length} {t('ci.careers', lang)}</span>
              </h2>
              <div class="table-wrap">
                <table>
                  <caption class="sr-only">
                    {t('ci.caption', lang, { category: catLabel(g.category.id, g.category.label) })}
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">{t('ci.colCareer', lang)}</th>
                      <th scope="col">{t('ci.colWhat', lang)}</th>
                      <th scope="col" class="num">{t('ci.colPeople', lang)}</th>
                      <th scope="col" class="num">{t('ci.colMedian', lang)}</th>
                      <th scope="col" class="num">{t('ci.colEntry', lang)}</th>
                      <th scope="col" class="num">{t('ci.colGrowth', lang)}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {g.items.map((c) => (
                      <tr>
                        <th scope="row">
                          <a href={withBase(`/careers/${c.soc}`)}>{c.title}</a>
                        </th>
                        <td class="what">{describe(c.soc, c.category).what}</td>
                        <td class="num">{formatNumber(c.employment)}</td>
                        <td class="num">{formatMoney(c.medianWage)}</td>
                        <td class="num">{formatMoney(c.entryWage)}</td>
                        <td class="num">{formatGrowth(c.growth)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          ))
        )
      }
      <p class="source-note">
        {t('ci.footnote', lang, { states: STATES.map((s) => s.name).join(', ') })}{' '}
        <a href={withBase('/sources')}>{t('ci.sources', lang)}</a>
        · <a href={withBase('/glossary')}>{t('ci.glossary', lang)}</a>
      </p>
    </div>
  </section>
</Base>

<script>
  const input = document.getElementById('career-search') as HTMLInputElement | null;
  const note = document.getElementById('search-note');

  if (input && note) {
    const es = input.dataset.lang === 'es';
    const total = note.dataset.total ?? '';
    const rows = Array.from(
      document.querySelectorAll<HTMLTableRowElement>('tbody tr'),
    );
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('.cat-section'),
    );

    const apply = () => {
      const term = input.value.trim().toLowerCase();
      let shown = 0;

      for (const row of rows) {
        const match = !term || (row.textContent || '').toLowerCase().includes(term);
        row.hidden = !match;
        if (match) shown += 1;
      }
      for (const section of sections) {
        const any = Array.from(
          section.querySelectorAll<HTMLTableRowElement>('tbody tr'),
        ).some((row) => !row.hidden);
        section.hidden = !any;
      }

      note.textContent = term
        ? es
          ? shown === 1
            ? `${shown} carrera coincide con "${input.value.trim()}".`
            : `${shown} carreras coinciden con "${input.value.trim()}".`
          : `${shown} career${shown === 1 ? '' : 's'} match "${input.value.trim()}".`
        : es
          ? `${total} carreras en la lista. Escribe para reducirla.`
          : `${total} careers listed. Type to narrow the list down.`;
    };

    input.addEventListener('input', apply);
    input.addEventListener('search', apply);
  }
</script>

<style>
  .search-box {
    margin-bottom: var(--space-l);
    max-width: 30rem;
  }
  .search-box label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .search-box input {
    width: 100%;
    font: inherit;
    padding: 0.7rem 1rem;
    border: 2px solid var(--paper-sunk);
    border-radius: var(--radius-m);
    background: var(--paper);
    color: var(--ink-900);
  }
  .search-box input:focus {
    border-color: var(--accent);
    outline: none;
  }
  .search-note {
    margin: 0.4rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-500);
  }

  .cat-section {
    margin-bottom: var(--space-xl);
  }
  .cat-section h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .cat-count {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-500);
    letter-spacing: 0;
    text-transform: none;
  }
  td.what {
    color: var(--ink-700);
    font-size: var(--step--1);
    min-width: 16rem;
  }
  @media (max-width: 700px) {
    td.what {
      display: none;
    }
  }
</style>
