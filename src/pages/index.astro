---
import { withBase } from '../lib/url';
import Base from '../layouts/Base.astro';
import StateCard from '../components/StateCard.astro';
import StatTile from '../components/StatTile.astro';
import Bars from '../components/Bars.astro';
import MyMatches from '../components/MyMatches.astro';
import HeroScience from '../components/HeroScience.astro';
import { STATES } from '../data/states';
import {
  getStateData,
  formatNumber,
  formatMoney,
  lastUpdated,
  byEmployment,
} from '../lib/data';
import { CATEGORIES } from '../data/states';
import { t, CATEGORY_BLURBS_ES, CATEGORY_LABELS_ES, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const stateData = STATES.map((s) => {
  const d = getStateData(s.code);
  return {
    state: s,
    headline: d?.live.total
      ? lang === 'es'
        ? `${formatNumber(d.live.total)} empleos STEM abiertos`
        : `${formatNumber(d.live.total)} open STEM jobs`
      : undefined,
    headlineNote: d ? t('stateCard.rightNow', lang) : undefined,
    available: Boolean(d),
  };
});

const updated = lastUpdated();

// A few numbers to put on the front page.
const nj = getStateData('nj');
const allOccupations = nj?.occupations ?? [];
const totalStemWorkers = allOccupations.reduce((sum, o) => sum + o.employment, 0);
const openNow = STATES.reduce(
  (sum, s) => sum + (getStateData(s.code)?.live.private?.total ?? 0),
  0,
);
const biggestJob = byEmployment(allOccupations).filter((o) => o.employment > 5000)[0];

const title =
  lang === 'es'
    ? 'Rutas STEM en Nueva Jersey, Nueva York y Pensilvania'
    : 'STEM Pathways in New Jersey, New York and Pennsylvania';
const description =
  lang === 'es'
    ? 'Mira cuántos empleos STEM están abiertos ahora mismo, cuánto pagan y dónde están: cifras reales para estudiantes de Nueva Jersey, Nueva York y Pensilvania.'
    : 'See how many STEM jobs are open right now, what they pay, and where the jobs are — real numbers for students in New Jersey, New York and Pennsylvania.';
---

<Base title={title} description={description} lang={lang} gateTarget>
  <section class="hero">
    <div class="wrap">
      <div class="hero__grid">
        <div class="hero__copy">
          <span class="hero__tag">
            <span aria-hidden="true">●</span> {t('home.tag', lang)}
          </span>
          <h1>{t('home.h1', lang)}</h1>
          <p class="lede">{t('home.lede', lang)}</p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={withBase("/nj")}>{t('home.ctaNj', lang)}</a>
            <a class="btn btn--ghost" href={withBase("/compare")}>{t('home.ctaCompare', lang)}</a>
            <button type="button" class="btn btn--sun" data-open-finder>
              {t('home.ctaFinder', lang)}
            </button>
          </div>
          {updated && <p class="stamp">{t('home.updated', lang)} {updated.slice(0, 10)}</p>}
          {lang === 'es' && <p class="stamp">{t('es.notice', lang)}</p>}
        </div>
          <div class="hero__logo-wrap">
            <HeroScience />
          </div>
      </div>
    </div>
  </section>

  {
    totalStemWorkers > 0 && (
      <section class="section section--tight">
        <div class="wrap">
          <div class="grid grid--3">
            <StatTile
              accent
              value={formatNumber(totalStemWorkers)}
              label={t('home.stat1.label', lang)}
              note={t('home.stat1.note', lang)}
            />
            <StatTile
              value={formatNumber(openNow)}
              label={t('home.stat2.label', lang)}
              note={t('home.stat2.note', lang)}
            />
            <StatTile
              value={formatNumber(biggestJob?.employment)}
              label={
                lang === 'es'
                  ? `personas trabajan como ${biggestJob?.title ?? 'trabajadores STEM'} en Nueva Jersey`
                  : `people work as ${biggestJob?.title ?? 'STEM workers'} in New Jersey`
              }
              note={t('home.stat3.note', lang)}
            />
          </div>
        </div>
      </section>
    )
  }

  <MyMatches lang={lang} />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{t('home.pick.eyebrow', lang)}</span>
        <h2>{t('home.pick.h2', lang)}</h2>
        <p class="lede">{t('home.pick.lede', lang)}</p>
      </div>

      <div class="grid grid--3">
        {stateData.map((s) => <StateCard state={s.state} headline={s.headline} headlineNote={s.headlineNote} available={s.available} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{t('home.seven.eyebrow', lang)}</span>
        <h2>{t('home.seven.h2', lang)}</h2>
        <p class="lede">{t('home.seven.lede', lang)}</p>
      </div>

      <div class="grid grid--3">
        {
          CATEGORIES.map((c) => (
            <article class="card card--flat" style={`--accent:${c.color}`}>
              <div class="cat__icon" aria-hidden="true">
                {c.icon}
              </div>
              <h3 class="card__title">
                {lang === 'es' ? (CATEGORY_LABELS_ES[c.id] ?? c.label) : c.label}
              </h3>
              <p class="muted">
                {lang === 'es' ? (CATEGORY_BLURBS_ES[c.id] ?? c.blurb) : c.blurb}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{t('home.how.eyebrow', lang)}</span>
        <h2>{t('home.how.h2', lang)}</h2>
        <p class="lede">{t('home.how.lede', lang)}</p>
      </div>
      <div class="grid grid--3">
        <article class="card card--flat">
          <h3 class="card__title">{t('home.how1.h3', lang)}</h3>
          <p class="muted">{t('home.how1.p', lang)}</p>
        </article>
        <article class="card card--flat">
          <h3 class="card__title">{t('home.how2.h3', lang)}</h3>
          <p class="muted">{t('home.how2.p', lang)}</p>
        </article>
        <article class="card card--flat">
          <h3 class="card__title">{t('home.how3.h3', lang)}</h3>
          <p class="muted">{t('home.how3.p', lang)}</p>
        </article>
      </div>
      <p class="source-note">
        {t('home.how.details', lang)} <a href={withBase("/sources")}>{t('home.how.sources', lang)}</a>
        · <a href={withBase("/glossary")}>{t('home.how.glossary', lang)}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .cat__icon {
    font-size: 1.75rem;
    line-height: 1;
    margin-bottom: var(--space-2xs);
  }
</style>
