---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const title = lang === 'es' ? 'Quiénes somos' : 'About Us';
const description =
  lang === 'es'
    ? 'Students 2 Science (S2S) inspira y empodera a los estudiantes mediante el aprendizaje práctico de STEM. Conoce quiénes somos, qué hacemos y por qué existe este sitio.'
    : 'Students 2 Science (S2S) inspires and empowers students through hands-on STEM learning. Learn who we are, what we do, and why this site exists.';
---

<Base title={title} description={description} lang={lang}>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag">
        <span aria-hidden="true">●</span> {t('about.tag', lang)}
      </span>
      <h1>{t('about.h1', lang)}</h1>
      <p class="lede">{t('about.lede', lang)}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap--narrow">
      <h2>{t('about.mission.h2', lang)}</h2>
      <p class="lede">{t('about.mission.p', lang)}</p>

      <h2>{t('about.vision.h2', lang)}</h2>
      <p class="lede">{t('about.vision.p', lang)}</p>
      <ul class="muted">
        <li>{t('about.vision.1', lang)}</li>
        <li>{t('about.vision.2', lang)}</li>
        <li>{t('about.vision.3', lang)}</li>
        <li>{t('about.vision.4', lang)}</li>
      </ul>

      <h2>{t('about.impact.h2', lang)}</h2>
      <p>{t('about.impact.p', lang)}</p>
      <div class="impact-grid">
        <article class="card card--flat">
          <h3 class="card__title">{t('about.impact1.h3', lang)}</h3>
          <p class="muted">{t('about.impact1.p', lang)}</p>
        </article>
        <article class="card card--flat">
          <h3 class="card__title">{t('about.impact2.h3', lang)}</h3>
          <p class="muted">{t('about.impact2.p', lang)}</p>
        </article>
        <article class="card card--flat">
          <h3 class="card__title">{t('about.impact3.h3', lang)}</h3>
          <p class="muted">{t('about.impact3.p', lang)}</p>
        </article>
      </div>

      <h2>{t('about.ach.h2', lang)}</h2>
      <ul class="muted">
        <li>{t('about.ach.1', lang)}</li>
        <li>{t('about.ach.2', lang)}</li>
        <li>{t('about.ach.3', lang)}</li>
        <li>{t('about.ach.4', lang)}</li>
        <li>{t('about.ach.5', lang)}</li>
      </ul>

      <h2>{t('about.site.h2', lang)}</h2>
      <p class="lede">
        {t('about.site.p1', lang)}
        {t('about.site.p2', lang)}
        <a href={withBase('/sources')}>{t('about.site.sources', lang)}</a>{t('about.site.p3', lang)}
        <a href={withBase('/labs2life')}>Labs2Life</a>{t('about.site.p4', lang)}
        <a href={withBase('/cap-program')}>{t('footer.cap2', lang)}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .impact-grid {
    display: grid;
    gap: var(--space-s);
    margin-block: var(--space-m);
  }
  @media (min-width: 46rem) {
    .impact-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
