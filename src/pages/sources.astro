---
import Base from '../layouts/Base.astro';
import { formatDate, lastUpdated } from '../lib/data';
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const updated = lastUpdated();

const title = lang === 'es' ? 'De dónde vienen los datos' : 'Where the data comes from';
const description =
  lang === 'es'
    ? 'Todas las fuentes de datos detrás de STEM Pathways, qué tomamos de cada una y con qué frecuencia las revisamos.'
    : 'Every data source behind STEM Pathways, what we take from it, and how often we check it.';
---

<Base title={title} description={description} lang={lang}>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag"><span aria-hidden="true">●</span> {t('src.tag', lang)}</span>
      <h1>{t('src.h1', lang)}</h1>
      <p class="lede">{t('src.lede', lang)}</p>
      {updated && <p class="stamp">{t('src.lastRun', lang)} {formatDate(updated, lang)}</p>}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="table-wrap">
        <table>
          <caption class="sr-only">{t('src.caption', lang)}</caption>
          <thead>
            <tr>
              <th scope="col">{t('src.colSource', lang)}</th>
              <th scope="col">{t('src.colUse', lang)}</th>
              <th scope="col">{t('src.colOften', lang)}</th>
              <th scope="col">{t('src.colCost', lang)}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">
                <a href="https://www.bls.gov/oes/">Bureau of Labor Statistics</a>
              </th>
              <td>{t('src.use.blsOes', lang)}</td>
              <td>{t('src.yearlyMay', lang)}</td>
              <td>{t('src.free', lang)}</td>
            </tr>
            <tr>
              <th scope="row">
                <a href="https://www.bls.gov/emp/">BLS Employment Projections</a>
              </th>
              <td>{t('src.use.blsEmp', lang)}</td>
              <td>{t('src.yearly', lang)}</td>
              <td>{t('src.free', lang)}</td>
            </tr>
            <tr>
              <th scope="row">
                <a href="https://www.usajobs.gov/">USAJOBS</a>
              </th>
              <td>{t('src.use.usajobs', lang)}</td>
              <td>{t('src.daily', lang)}</td>
              <td>{t('src.free', lang)}</td>
            </tr>
            <tr>
              <th scope="row">
                <a href="https://www.careeronestop.org/">CareerOneStop</a>
              </th>
              <td>{t('src.use.cos', lang)}</td>
              <td>{t('src.daily', lang)}</td>
              <td>{t('src.free', lang)}</td>
            </tr>
            <tr>
              <th scope="row">
                <a href="https://info.csc.nj.gov/jobannouncements/">NJ Civil Service</a>
              </th>
              <td>{t('src.use.nj', lang)}</td>
              <td>{t('src.daily', lang)}</td>
              <td>{t('src.free', lang)}</td>
            </tr>
            <tr>
              <th scope="row">
                <a href="https://statejobs.ny.gov/">StateJobsNY</a>
              </th>
              <td>{t('src.use.ny', lang)}</td>
              <td>{t('src.daily', lang)}</td>
              <td>{t('src.free', lang)}</td>
            </tr>
            <tr>
              <th scope="row">
                <a href="https://careers.employment.pa.gov/">Commonwealth Careers</a>
              </th>
              <td>{t('src.use.pa', lang)}</td>
              <td>{t('src.daily', lang)}</td>
              <td>{t('src.free', lang)}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="grid grid--2 notes">
        <article class="card card--flat">
          <h3 class="card__title">{t('src.note1.h3', lang)}</h3>
          <p class="muted">{t('src.note1.p', lang)}</p>
        </article>
        <article class="card card--flat">
          <h3 class="card__title">{t('src.note2.h3', lang)}</h3>
          <p class="muted">{t('src.note2.p', lang)}</p>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .notes {
    margin-top: var(--space-l);
  }
</style>
