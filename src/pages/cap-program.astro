---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const title = lang === 'es' ? 'Programa CAP' : 'CAP Program';
const description =
  lang === 'es'
    ? 'El Programa de Avance Profesional (CAP) ofrece a los estudiantes de preparatoria educación, formación laboral y exploración de carreras: pasantías, mentoría y formación de preparación profesional.'
    : 'The Career Advancement Program (CAP) gives high school students education, job training and career exploration - internships, mentoring and career-readiness training.';
---

<Base title={title} description={description} lang={lang}>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag">
        <span aria-hidden="true">●</span> {t('cap.tag', lang)}
      </span>
      <h1>{t('cap.h1', lang)}</h1>
      <p class="lede">{t('cap.lede', lang)}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap--narrow">
      <h2>{t('cap.what.h2', lang)}</h2>
      <p>{t('cap.what.p1', lang)}</p>
      <p class="muted">{t('cap.what.p2', lang)}</p>

      <h2>{t('cap.sig.h2', lang)}</h2>
      <div class="cap-grid">
        <article class="card card--flat">
          <h3 class="card__title">{t('cap.sig1.h3', lang)}</h3>
          <p class="muted">{t('cap.sig1.p', lang)}</p>
        </article>
        <article class="card card--flat">
          <h3 class="card__title">{t('cap.sig2.h3', lang)}</h3>
          <p class="muted">{t('cap.sig2.p', lang)}</p>
        </article>
      </div>

      <h2>{t('cap.more.h2', lang)}</h2>
      <ul class="cap-list">
        <li>
          <strong>{t('cap.more.1a', lang)}</strong>{t('cap.more.1b', lang)}
        </li>
        <li>
          <strong>{t('cap.more.2a', lang)}</strong>{t('cap.more.2b', lang)}
        </li>
        <li>
          <strong>{t('cap.more.3a', lang)}</strong>{t('cap.more.3b', lang)}
        </li>
      </ul>

      <h2>{t('cap.corp.h2', lang)}</h2>
      <p>
        {t('cap.corp.p', lang)}
        <a href="mailto:CAP@students2science.org">{t('cap.corp.email', lang)}</a>.
      </p>

      <p class="source-note">
        {t('cap.note.1', lang)} <a href={withBase('/labs2life')}>Labs2Life</a>{' '}
        {t('cap.note.2', lang)}{' '}
        <a href={withBase('/careers')}>{t('cap.note.3', lang)}</a>{' '}
        {t('cap.note.4', lang)}
      </p>
    </div>
  </section>
</Base>

<style>
  .cap-grid {
    display: grid;
    gap: var(--space-s);
    margin-block: var(--space-m);
  }
  @media (min-width: 46rem) {
    .cap-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .cap-list {
    margin: var(--space-s) 0;
    display: grid;
    gap: var(--space-xs);
  }
  .cap-list li {
    padding: 0.8rem 1rem;
    border: 1px solid var(--paper-sunk, #e5e7eb);
    border-radius: var(--radius-m);
  }
</style>
