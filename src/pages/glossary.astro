---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const termsEn = [
  {
    term: 'STEM',
    def: `Science, Technology, Engineering and Math. A loose group of careers that use math, science and problem solving. There is no single official list, so every site picks its own - ours is described on the <a href="${withBase('/sources')}">sources page</a>.`,
  },
  {
    term: 'Occupation',
    def: 'A kind of job, not a company. "Registered Nurse" is an occupation whether you work at a hospital in Newark or a clinic in Boise.',
  },
  {
    term: 'SOC code',
    def: 'A six-digit number the government uses to sort every job into a box - for example 29-1141 is Registered Nurses. On this site the code is the link in each job\'s address, like /careers/29-1141.',
  },
  {
    term: 'Employment',
    def: 'How many people are working in a job right now, counted by the Bureau of Labor Statistics in their May survey of employers.',
  },
  {
    term: 'Median pay',
    def: 'The pay of the person in the middle of the range. Half earn more, half earn less. It is usually a fairer number than the average, because one very high salary can drag the average up.',
  },
  {
    term: 'Mean (average) pay',
    def: 'All the salaries added together and divided by how many people there are. Handy, but easily pulled up by a handful of very high earners.',
  },
  {
    term: 'Entry wage',
    def: 'What people usually earn when they are brand new at the job - the 10th percentile of the pay range.',
  },
  {
    term: 'Job growth',
    def: 'The Bureau of Labor Statistics prediction for how many more jobs there will be in a decade. It is a projection, not a promise.',
  },
  {
    term: 'Job openings',
    def: 'How many jobs are expected to open each year - not only new jobs, but also jobs people leave behind. A lot of openings in a field means a lot of hiring.',
  },
  {
    term: 'Metro area',
    def: 'A city and everything around it that shares one job market. "New York-Newark-Jersey City" is one metro area that covers parts of two states.',
  },
  {
    term: 'Civil service',
    def: 'Government jobs that have to be filled through a hiring list. Applying for a civil service exam puts you on the list, and agencies hire from it.',
  },
  {
    term: 'USAJOBS',
    def: 'The official website for federal government jobs - the Department of Defense, NASA, the FAA and about 500 other agencies.',
  },
  {
    term: 'CareerOneStop',
    def: 'A Department of Labor website that collects job postings from many private-sector job boards into one search.',
  },
  {
    term: 'Posting vs announcement',
    def: 'A posting is a specific job you can apply for. An announcement (like a New Jersey civil service exam) is an invitation to take a test so you can be considered for a list of jobs.',
  },
  {
    term: 'Private sector',
    def: 'Jobs at companies that are not part of government - a hospital, a software firm, a factory. Private-sector job postings come from CareerOneStop, which collects openings from thousands of employers.',
  },
  {
    term: 'Survey vs live count',
    def: 'The Bureau of Labor Statistics counts everyone on the payroll, but only once a year. Live counts come from job boards and change every day. That is why the two numbers never quite match.',
  },
  {
    term: 'Apprenticeship',
    def: 'A paid training program where you work and learn at the same time, usually for several years. Many skilled trades and some STEM jobs are built on apprenticeships.',
  },
  {
    term: 'Industry',
    def: 'The kind of business an employer is in - a hospital, a software company, a construction firm. The same job title can exist in many industries.',
  },
  {
    term: 'Projected growth',
    def: 'A prediction from the Bureau of Labor Statistics about how many jobs will exist in the future. It is based on assumptions, so treat it as a strong hint rather than a promise.',
  },
  {
    term: 'Starting pay',
    def: 'What people usually earn when they are brand new at the job - the 10th percentile of the pay range.',
  },
];

const termsEs = [
  {
    term: 'STEM',
    def: `Ciencia, Tecnología, Ingeniería y Matemáticas. Un grupo amplio de carreras que usan matemáticas, ciencia y resolución de problemas. No hay una lista oficial única, así que cada sitio elige la suya: la nuestra se describe en la <a href="${withBase('/es/sources')}">página de fuentes</a>.`,
  },
  {
    term: 'Ocupación',
    def: 'Un tipo de empleo, no una empresa. "Enfermera registrada" es una ocupación tanto si trabajas en un hospital de Newark como en una clínica de Boise.',
  },
  {
    term: 'Código SOC',
    def: 'Un número de seis dígitos que el gobierno usa para clasificar cada empleo: por ejemplo, 29-1141 es Enfermeras Registradas. En este sitio el código está en la dirección de cada empleo, como /careers/29-1141.',
  },
  {
    term: 'Empleo',
    def: 'Cuántas personas trabajan en un puesto ahora mismo, contado por la Oficina de Estadísticas Laborales en su encuesta de mayo a los empleadores.',
  },
  {
    term: 'Pago mediano',
    def: 'El pago de la persona que está en el medio del rango. La mitad gana más, la mitad gana menos. Suele ser una cifra más justa que el promedio, porque un salario muy alto puede elevar el promedio.',
  },
  {
    term: 'Pago medio (promedio)',
    def: 'Todos los salarios sumados y divididos entre el número de personas. Útil, pero fácilmente elevado por un puñado de personas que ganan mucho.',
  },
  {
    term: 'Salario inicial',
    def: 'Lo que suele ganar la gente cuando es completamente nueva en el puesto: el percentil 10 del rango salarial.',
  },
  {
    term: 'Crecimiento del empleo',
    def: 'La predicción de la Oficina de Estadísticas Laborales sobre cuántos empleos más habrá en una década. Es una proyección, no una promesa.',
  },
  {
    term: 'Vacantes',
    def: 'Cuántos empleos se espera que se abran cada año: no solo empleos nuevos, también los que la gente deja. Muchas vacantes en un campo significa mucha contratación.',
  },
  {
    term: 'Zona metropolitana',
    def: 'Una ciudad y todo lo que la rodea que comparte un mercado laboral. "New York-Newark-Jersey City" es una zona metropolitana que cubre partes de dos estados.',
  },
  {
    term: 'Servicio civil',
    def: 'Empleos del gobierno que deben cubrirse mediante una lista de contratación. Postularte a un examen de servicio civil te pone en la lista, y las agencias contratan desde ella.',
  },
  {
    term: 'USAJOBS',
    def: 'El sitio web oficial de empleos del gobierno federal: el Departamento de Defensa, la NASA, la FAA y unas 500 agencias más.',
  },
  {
    term: 'CareerOneStop',
    def: 'Un sitio web del Departamento de Trabajo que reúne ofertas de muchas bolsas de trabajo del sector privado en una sola búsqueda.',
  },
  {
    term: 'Oferta vs convocatoria',
    def: 'Una oferta es un empleo concreto al que puedes postularte. Una convocatoria (como un examen de servicio civil de Nueva Jersey) es una invitación a hacer una prueba para ser considerado para una lista de empleos.',
  },
  {
    term: 'Sector privado',
    def: 'Empleos en empresas que no son parte del gobierno: un hospital, una empresa de software, una fábrica. Las ofertas del sector privado vienen de CareerOneStop, que reúne vacantes de miles de empleadores.',
  },
  {
    term: 'Encuesta vs conteo en vivo',
    def: 'La Oficina de Estadísticas Laborales cuenta a todos los que están en nómina, pero solo una vez al año. Los conteos en vivo vienen de las bolsas de trabajo y cambian cada día. Por eso los dos números nunca coinciden del todo.',
  },
  {
    term: 'Aprendizaje',
    def: 'Un programa de formación pagado donde trabajas y aprendes al mismo tiempo, normalmente durante varios años. Muchos oficios especializados y algunos empleos STEM se basan en aprendizajes.',
  },
  {
    term: 'Industria',
    def: 'El tipo de negocio de un empleador: un hospital, una empresa de software, una constructora. El mismo título de puesto puede existir en muchas industrias.',
  },
  {
    term: 'Crecimiento proyectado',
    def: 'Una predicción de la Oficina de Estadísticas Laborales sobre cuántos empleos existirán en el futuro. Se basa en suposiciones, así que tómalo como una pista fuerte y no como una promesa.',
  },
  {
    term: 'Pago inicial',
    def: 'Lo que suele ganar la gente cuando es completamente nueva en el puesto: el percentil 10 del rango salarial.',
  },
];

const terms = lang === 'es' ? termsEs : termsEn;

const title = lang === 'es' ? 'Palabras STEM explicadas' : 'STEM words explained';
const description =
  lang === 'es'
    ? 'Un glosario en lenguaje sencillo de las palabras de datos y empleo usadas en este sitio, para estudiantes y maestros.'
    : 'A plain-English glossary of the data and job words used on this site, for students and teachers.';
---

<Base title={title} description={description} lang={lang}>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag"><span aria-hidden="true">●</span> {t('glo.tag', lang)}</span>
      <h1>{t('glo.h1', lang)}</h1>
      <p class="lede">{t('glo.lede', lang)}</p>
      <p class="small muted">{t('glo.small', lang)}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap--narrow">
      <dl class="glossary">
        {
          terms.map((entry) => (
            <div class="glossary__item">
              <dt>{entry.term}</dt>
              <dd set:html={entry.def} />
            </div>
          ))
        }
      </dl>
      <p class="source-note">
        {t('glo.missing', lang)} <a href={withBase('/sources')}>{t('glo.tellus', lang)}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .glossary {
    margin: 0;
  }
  .glossary__item {
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--paper-sunk);
  }
  .glossary__item:last-child {
    border-bottom: 0;
  }
  .glossary dt {
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .glossary dd {
    margin: 0.3rem 0 0;
    color: var(--ink-700);
  }
</style>
