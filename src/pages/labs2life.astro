          { soc: '19-2031', role: 'Chemist' },
          { soc: '19-4031', role: 'Lab Technician (Chemical)' },
          { soc: '29-2052', role: 'Pharmacy Technician' },
          { soc: '29-1051', role: 'Pharmacist' },
        ],
      },
      {
        title: 'Bridges',
        icon: '🌉',
        careers: [
          { soc: '17-2051', role: 'Civil Engineer' },
          { soc: '17-2141', role: 'Mechanical Engineer' },
          { soc: '17-3022', role: 'Structural Engineering Technician (Civil)' },
          { soc: '15-1252', role: 'Transportation Modeller (Software Developer)' },
        ],
      },
      {
        title: 'Green Machine',
        icon: '🌱',
        careers: [
          { soc: '19-2041', role: 'Environmental Scientist' },
          { soc: '19-4021', role: 'Biotechnologist (Biological Technician)' },
          { soc: '17-3025', role: 'Environmental Engineering Technician' },
        ],
      },
      {
        title: "You Can't Be Cereus",
        icon: '🧫',
        careers: [
          { soc: '19-1021', role: 'Biotechnologist (Biochemist)' },
          { soc: '15-2051', role: 'Bioinformatics (Data Scientist)' },
