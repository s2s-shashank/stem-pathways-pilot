---
/**
 * Labs2Life - the labs Students 2 Science runs, and the careers behind them.
 *
 * Careers link to the existing career pages (/careers/[soc]). Jobs are
 * matched to the occupations the site actually tracks; where a lab role has
 * no exact match, the closest tracked occupation is used.
 */
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import { allStateData } from '../lib/data';
import { CATEGORY_MAP } from '../data/states';
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

type Career = { soc: string; role: string };
type Lab = {
  title: string;
  icon: string;
  careers: Career[];
};

// The jobs this site tracks, with the category colour to label each one.
const tracked = new Map<string, { title: string; cat: string }>();
for (const data of allStateData()) {
  for (const o of data.occupations) {
    if (!tracked.has(o.soc)) {
      tracked.set(o.soc, {
        title: o.title,
        cat: CATEGORY_MAP[o.category]?.color ?? 'var(--accent)',
      });
    }
  }
}

const LEVEL_KEYS = ['l2l.level.elementary', 'l2l.level.middle', 'l2l.level.high'] as const;
const groups: { level: string; blurb: string; labs: Lab[] }[] = [
  {
    level: t(LEVEL_KEYS[0], lang),
    labs: [
      {
        title: 'Adaptations to Environmental Changes',
        icon: '🦎',
        careers: [
          { soc: '19-1013', role: 'Soil and Plant Scientist' },
          { soc: '19-1023', role: 'Zoologist and Wildlife Biologist' },
          { soc: '19-1031', role: 'Conservation Scientist' },
        ],
      },
      {
        title: 'Nature',
        icon: '🌳',
        careers: [
          { soc: '19-1023', role: 'Zoologist and Wildlife Biologist' },
          { soc: '19-2041', role: 'Environmental Scientist' },
          { soc: '19-4012', role: 'Agricultural Technician' },
        ],
      },
      {
        title: 'Dams',
        icon: '🌊',
        careers: [
          { soc: '17-2051', role: 'Civil Engineer' },
          { soc: '19-4044', role: 'Hydrologic Technician' },
          { soc: '51-8031', role: 'Water Treatment Plant Operator' },
          { soc: '17-2081', role: 'Environmental Engineer' },
        ],
      },
      {
        title: 'Global Warming',
        icon: '🌍',
        careers: [
          { soc: '19-2021', role: 'Atmospheric and Space Scientist' },
          { soc: '19-2041', role: 'Environmental Scientist' },
          { soc: '19-2042', role: 'Geoscientist' },
          { soc: '17-2081', role: 'Environmental Engineer' },
        ],
      },
    ],
  },

  {
    level: t(LEVEL_KEYS[1], lang),
    labs: [
      {
        title: 'Disease Detectives',
        icon: '🔬',
        careers: [
          { soc: '19-1041', role: 'Epidemiologist' },
          { soc: '29-2010', role: 'Clinical Laboratory Technologist (LabCorp-style labs)' },
          { soc: '29-2099', role: 'Phlebotomist & Urinalysis Technician' },
          { soc: '15-2041', role: 'Statistician' },
          { soc: '19-1042', role: 'NIH Research Scientist' },
          { soc: '19-4031', role: 'Toxicology Technician' },
          { soc: '29-2061', role: 'Health Care Assistant (LPN)' },
        ],
      },
      {
        title: 'Metal Marvels',
        icon: '⚡',
        careers: [
          { soc: '17-2071', role: 'Electrical Engineer' },
          { soc: '17-2041', role: 'Electroplating Engineer (Chemical Engineer)' },
          { soc: '19-2031', role: 'Battery Scientist (Chemist)' },
          { soc: '19-2032', role: 'Materials Scientist' },
        ],
      },
      {
        title: 'Self-Driving Robot',
        icon: '🤖',
        careers: [
          { soc: '17-3024', role: 'Robotics Engineer (Mechatronics)' },
          { soc: '17-2199', role: 'Autonomous Systems Engineer' },
          { soc: '17-2071', role: 'Electrical Engineer' },
          { soc: '15-1252', role: 'Software Developer' },
          { soc: '15-2051', role: 'AI / ML Specialist (Data Scientist)' },
          { soc: '17-2061', role: 'Hardware Designer (Computer Hardware Engineer)' },
        ],
      },
      {
