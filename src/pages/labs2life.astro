---
/**
 * Labs2Life - the labs Students 2 Science runs, and the careers behind them.
 *
 * Careers link to the existing career pages (/careers/[soc]). Jobs are
 * matched to the occupations the site actually tracks; where a lab role has
 * no exact match, the closest tracked occupation is used.
 */
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import { allStateData } from '../lib/data';
import { CATEGORY_MAP } from '../data/states';

type Career = { soc: string; role: string };
type Lab = {
  title: string;
  icon: string;
  careers: Career[];
};

// The jobs this site tracks, with the category colour to label each one.
const tracked = new Map<string, { title: string; cat: string }>();
for (const data of allStateData()) {
  for (const o of data.occupations) {
    if (!tracked.has(o.soc)) {
      tracked.set(o.soc, {
        title: o.title,
        cat: CATEGORY_MAP[o.category]?.color ?? 'var(--accent)',
      });
    }
  }
}

