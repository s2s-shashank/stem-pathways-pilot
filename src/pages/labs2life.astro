          { soc: '19-4092', role: 'Toxicology Technician (Forensic Science)' },
        ],
      },
      {
        title: 'Pharma Day',
        icon: '⚗️',
        careers: [
          { soc: '19-2031', role: 'Chemist' },
          { soc: '19-4031', role: 'HPLC / GC Analyst (Chemical Technician)' },
          { soc: '29-2052', role: 'Pharmacy Technician' },
          { soc: '29-1051', role: 'Pharmacist' },
          { soc: '19-1042', role: 'Medical Scientist (Drug Research)' },
          { soc: '51-8091', role: 'Chemical Plant Operator (Pharma Manufacturing)' },
        ],
      },
    ],
  },];

// Only link careers this site tracks, so every link always resolves.
interface RenderLab extends Omit<Lab, 'careers'> {
  careers: Array<{
    soc: string;
    url: string;
    exists: boolean;
    title: string;
    cat: string;
    role: string;
  }>;
}
const renderGroups = groups.map((g) => ({
  ...g,
  labs: g.labs.map((lab) => {
    const careers = lab.careers.map((c) => {
      const job = tracked.get(c.soc);
      return {
        ...c,
        title: job?.title ?? c.role,
        cat: job?.cat ?? 'var(--accent)',
        url: withBase(`/careers/${c.soc}`),
        exists: Boolean(job),
      };
    });
    return { ...lab, careers };
  }),
}));
---

<Base
  title="Labs2Life"
  description={lang === 'es'
    ? 'Los laboratorios que Students 2 Science imparte en primaria, secundaria y preparatoria, y las carreras reales detrás de cada experimento.'
    : 'The labs Students 2 Science covers in elementary, middle and high school - and the real careers each experiment connects to.'}
  lang={lang}
>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag">
        <span aria-hidden="true">●</span> Labs2Life
      </span>
      <h1>{t('l2l.h1', lang)}</h1>
      <p class="lede">{t('l2l.lede', lang)}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={withBase('/careers')}>{t('l2l.browse', lang)}</a>
        <a class="btn btn--ghost" href={withBase('/about')}>{t('l2l.about', lang)}</a>
      </div>
      {lang === 'es' && <p class="stamp">{t('es.notice', lang)}</p>}
    </div>
  </section>

  {
    renderGroups.map((group, i) => (
      <section class={i % 2 === 1 ? 'section section--alt' : 'section'}>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{group.level}</span>
            <h2>{t('l2l.labs', lang, { count: group.labs.length })}</h2>
            {group.blurb && <p class="lede">{group.blurb}</p>}
          </div>
          <div class="lab-grid">
            {group.labs.map((lab) => (
              <details class="card lab-card">
                <summary class="lab-card__head">
                  <span class="lab-card__icon" aria-hidden="true">
                    {lab.icon}
                  </span>
                  <span class="lab-card__heading">
                    <span class="lab-card__name">{lab.title}</span>
                    {lab.careers.length > 0 && (
                      <span class="lab-card__count">
                        {t('l2l.kicker', lang)} · {lab.careers.length}
                      </span>
                    )}
                  </span>
                  <span class="lab-card__chevron" aria-hidden="true" />
                </summary>
                <div class="lab-card__body">
                  <ul class="lab-card__careers">
                    {lab.careers.map((c) => (
                      <li>
                        {c.exists ? (
                          <a href={c.url} style={`--cat:${c.cat}`}>
                            <span aria-hidden="true" class="lab-card__dot" />
                            {c.role}
                            <span class="lab-card__title">{c.title}</span>
                          </a>
                        ) : (
                          <span class="lab-card__soon" style="--cat:var(--ink-300)">
                            <span aria-hidden="true" class="lab-card__dot" />
                            {c.role}
                            <span class="lab-card__title">{t('l2l.soon', lang)}</span>
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--alt">
    <div class="wrap wrap--narrow">
      <div class="section-head">
        <span class="eyebrow">{t('l2l.match.eyebrow', lang)}</span>
        <h2>{t('l2l.match.h2', lang)}</h2>
        <p class="lede">{t('l2l.match.lede', lang)}</p>
        <button type="button" class="btn btn--sun" data-open-finder>
          {t('home.ctaFinder', lang)}
        </button>
      </div>
    </div>
  </section>
</Base>

<style>
  .lab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: var(--space-s);
    align-items: start;
  }
  .lab-card {
    padding: 0;
    overflow: hidden;
  }
  .lab-card[open] {
    box-shadow: var(--shadow-m);
  }
  .lab-card__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    padding: var(--space-m);
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-l);
    transition: background 0.15s ease;
  }
  .lab-card__head::-webkit-details-marker {
    display: none;
  }
  .lab-card__head:hover {
    background: var(--paper-alt);
  }
  .lab-card__head:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 55%, transparent);
    outline-offset: -3px;
  }
  .lab-card__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-m);
    background: var(--paper-alt);
    font-size: 1.45rem;
    line-height: 1;
  }
  .lab-card__heading {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .lab-card__name {
    font-size: var(--step-0);
    font-weight: 750;
    line-height: 1.2;
    color: var(--ink-900);
  }
  .lab-card__count {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-500);
  }
  .lab-card__chevron {
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.2rem;
    border-right: 2px solid var(--ink-500);
    border-bottom: 2px solid var(--ink-500);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }
  .lab-card[open] .lab-card__chevron {
    transform: rotate(-135deg);
  }
  .lab-card__body {
    padding: var(--space-s) var(--space-m) var(--space-m);
    border-top: 1px solid var(--paper-sunk);
  }
  .lab-card__careers {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .lab-card__careers a,
  .lab-card__soon {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    padding: 0.45rem 0.7rem 0.45rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--cat) 30%, var(--paper-sunk));
    background: color-mix(in srgb, var(--cat) 8%, var(--paper));
    border-radius: var(--radius-m);
    font-weight: 600;
    color: var(--ink-700);
    text-decoration: none;
  }
  .lab-card__careers a:hover,
  .lab-card__careers a:focus-visible {
    background: color-mix(in srgb, var(--cat) 15%, var(--paper));
    border-color: var(--cat);
    color: var(--ink-900);
  }
  .lab-card__soon {
    color: var(--ink-500);
  }
  .lab-card__dot {
    align-self: center;
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--cat);
    margin-right: 0.1rem;
  }
  .lab-card__title {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-500);
  }
</style>
