// Only link careers this site tracks, so every link always resolves.
interface RenderLab extends Omit<Lab, 'careers'> {
  careers: Array<{
    soc: string;
    url: string;
    exists: boolean;
    title: string;
    cat: string;
    role: string;
  }>;
}
const renderGroups = groups.map((g) => ({
  ...g,
  labs: g.labs.map((lab) => {
    const careers = lab.careers.map((c) => {
      const job = tracked.get(c.soc);
      return {
        ...c,
        title: job?.title ?? c.role,
        cat: job?.cat ?? 'var(--accent)',
        url: withBase(`/careers/${c.soc}`),
        exists: Boolean(job),
      };
    });
    return { ...lab, careers };
  }),
}));
---

<Base
  title="Labs2Life"
  description="The labs Students 2 Science covers in elementary, middle and high school - and the real careers each experiment connects to."
>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag">
        <span aria-hidden="true">●</span> Labs2Life
      </span>
      <h1>From a lab experiment to a real career</h1>
      <p class="lede">
        Every experiment you do in an S2S lab is the daily work of somebody
        somewhere. Pick a lab, see the careers behind it, and click through to
        the real numbers - pay, openings, growth - for each job.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={withBase('/careers')}>Browse all careers</a>
        <a class="btn btn--ghost" href={withBase('/about')}>About Students 2 Science</a>
      </div>
    </div>
  </section>

  {
    renderGroups.map((group) => (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{group.level}</span>
            <h2>{group.labs.length} labs</h2>
            <p class="lede">{group.blurb}</p>
          </div>
          <div class="grid grid--2 lab-grid">
            {group.labs.map((lab) => (
              <article class="card lab-card">
                <div class="lab-card__head">
                  <span class="lab-card__icon" aria-hidden="true">
                    {lab.icon}
                  </span>
                  <h3 class="card__title">{lab.title}</h3>
                </div>
                {lab.careers.length > 0 && (
                  <p class="lab-card__kicker">Careers in this lab</p>
                )}
                <ul class="lab-card__careers">
                  {lab.careers.map((c) => (
                    <li>
                      {c.exists ? (
                        <a href={c.url} style={`--cat:${c.cat}`}>
                          <span aria-hidden="true" class="lab-card__dot" />
                          {c.role}
                          <span class="lab-card__title">{c.title}</span>
                        </a>
                      ) : (
                        <span class="lab-card__soon" style="--cat:var(--ink-300)">
                          <span aria-hidden="true" class="lab-card__dot" />
                          {c.role}
                          <span class="lab-card__title">Profile coming soon</span>
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--alt">
    <div class="wrap wrap--narrow">
      <div class="section-head">
        <span class="eyebrow">Not sure which fits you?</span>
        <h2>Get matched instead</h2>
        <p class="lede">
          The Career Exploration quiz asks a few questions about what you like
          doing, then shows the jobs that match - with real salaries and job
          openings.
        </p>
        <button type="button" class="btn btn--sun" data-open-finder>
          Career Exploration
        </button>
      </div>
    </div>
  </section>
</Base>

<style>
  .lab-grid {
    align-items: start;
  }
  .lab-card__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .lab-card__icon {
    font-size: 1.6rem;
    line-height: 1;
  }
  .lab-card__kicker {
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-500);
    margin: var(--space-s) 0 0.3rem;
  }
  .lab-card__careers {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .lab-card__careers a,
  .lab-card__soon {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    padding: 0.45rem 0.7rem 0.45rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--cat) 30%, var(--paper-sunk));
    background: color-mix(in srgb, var(--cat) 8%, var(--paper));
    border-radius: var(--radius-m);
    font-weight: 600;
    color: var(--ink-700);
    text-decoration: none;
  }
  .lab-card__careers a:hover,
  .lab-card__careers a:focus-visible {
    background: color-mix(in srgb, var(--cat) 15%, var(--paper));
    border-color: var(--cat);
    color: var(--ink-900);
  }
  .lab-card__soon {
    color: var(--ink-500);
  }
  .lab-card__dot {
    align-self: center;
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--cat);
    margin-right: 0.1rem;
  }
  .lab-card__title {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-500);
  }
</style>
