---
/**
 * "Your matches" - the results the student just got from the popup.
 *
 * The finder hands its results over with a `stemjobs:finder-results`
 * event. Nothing is stored, so this section stays hidden until the
 * student has actually finished a run on this page.
 */
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
---

<section class="section section--alt" id="my-matches" hidden data-lang={lang}>
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{t('mm.eyebrow', lang)}</span>
      <h2>{t('mm.h2', lang)}</h2>
      <p class="lede">{t('mm.lede', lang)}</p>
    </div>

    <div class="my-matches__bar">
      <p class="my-matches__note" id="my-matches-note"></p>
      <button type="button" class="btn btn--outline" data-open-finder>
        {t('mm.again', lang)}
      </button>
    </div>

    <div class="my-matches__list" id="my-matches-list"></div>
  </div>
</section>

<script>
  import { matchCardHtml, type Match } from '../lib/finder-client';

  const section = document.getElementById('my-matches');
  const list = document.getElementById('my-matches-list');
  const note = document.getElementById('my-matches-note');

  if (section && list && note) {
    const es = section.dataset.lang === 'es';
    document.addEventListener('stemjobs:finder-results', (e) => {
      const { matches, state } = (e as CustomEvent<{
        matches: Match[];
        state: string;
      }>).detail;

      if (!matches?.length) return;

      list.innerHTML = matches.map((m) => matchCardHtml(m, state)).join('');
      section.hidden = false;

      const names: Record<string, [string, string]> = {
        nj: ['New Jersey', 'Nueva Jersey'],
        ny: ['New York', 'Nueva York'],
        pa: ['Pennsylvania', 'Pensilvania'],
      };
      const where =
        state === 'other'
          ? es
            ? 'Nueva Jersey, Nueva York y Pensilvania'
            : 'New Jersey, New York and Pennsylvania'
          : names[state]?.[es ? 1 : 0] ?? (es ? 'tu zona' : 'your area');

      note.textContent = es
        ? `${matches.length} empleos, con precios para ${where}.`
        : `${matches.length} jobs, priced for ${where}.`;
    });
  }
</script>

<style>
  .my-matches__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-l);
  }

  .my-matches__note {
    margin: 0;
    font-weight: 700;
    color: var(--ink-700);
  }

  .my-matches__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-s);
  }
</style>
