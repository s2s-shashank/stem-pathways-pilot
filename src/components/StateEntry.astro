---
import Base from '../layouts/Base.astro';
import StatePage from './StatePage.astro';
import { STATE_MAP } from '../data/states';
import type { Lang } from '../i18n';

interface Props {
  code: 'nj' | 'ny' | 'pa';
  lang?: Lang;
}

const { code, lang = 'en' } = Astro.props;
const state = STATE_MAP[code];

const title =
  lang === 'es' ? `Rutas STEM hacia ${state.name}` : `STEM Pathways to ${state.name}`;
const description =
  lang === 'es'
    ? `Cuántos empleos STEM están abiertos en ${state.name} ahora mismo, cuánto pagan, dónde están los empleos y qué estudiar para conseguir uno.`
    : `How many STEM jobs are open in ${state.name} right now, what they pay, where the jobs are, and what to study to get one.`;
---

<Base title={title} description={description} lang={lang}>
  <StatePage state={state} lang={lang} />
</Base>
