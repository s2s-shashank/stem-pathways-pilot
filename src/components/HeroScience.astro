---
import { withBase } from '../lib/url';
// Science-themed elements that orbit the hero logo in a circular pattern.
---
<div class="hero__logo-wrap">
  <div class="hero__orbit-center" aria-hidden="true">
    <div class="hero__orbit-container">
      <span class="hero__decor-item hero__decor-item--dna">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M8 2c0 4 8 6 8 10s-8 6-8 10" />
          <path d="M16 2c0 4-8 6-8 10s8 6 8 10" />
          <path d="M9.3 6.5h5.4M9.3 12h5.4M9.3 17.5h5.4" />
        </svg>
      </span>

      <span class="hero__decor-item hero__decor-item--pi">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <path d="M5 7h14M9 7v12M15 7v8a2.5 2.5 0 0 0 2.5 2.5" />
        </svg>
      </span>

      <span class="hero__decor-item hero__decor-item--sigma">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 5H7l7 7-7 7h10" />
        </svg>
      </span>

      <span class="hero__decor-item hero__decor-item--robot">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <rect x="5" y="7.5" width="14" height="11" rx="2.5" />
          <path d="M12 3v4.5M8 18.5v2M16 18.5v2" />
          <circle cx="9.5" cy="12.5" r="1.3" fill="currentColor" stroke="none" />
          <circle cx="14.5" cy="12.5" r="1.3" fill="currentColor" stroke="none" />
          <path d="M9.5 15.5h5" />
        </svg>
      </span>

      <span class="hero__decor-item hero__decor-item--flask">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 3h6M10 3v5l-5 9a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 17l-5-9V3" />
          <path d="M8 15h8" />
          <circle cx="11" cy="18" r="0.8" fill="currentColor" stroke="none" />
          <circle cx="14" cy="17" r="0.6" fill="currentColor" stroke="none" />
        </svg>
      </span>

      <span class="hero__decor-item hero__decor-item--atom">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <ellipse cx="12" cy="12" rx="10" ry="4.3" />
          <ellipse cx="12" cy="12" rx="10" ry="4.3" transform="rotate(60 12 12)" />
          <ellipse cx="12" cy="12" rx="10" ry="4.3" transform="rotate(120 12 12)" />
          <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
        </svg>
      </span>

      <span class="hero__decor-item hero__decor-item--globe">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <path d="M2 12h20" />
          <path d="M12 2c-2.5 2.5-2.5 7.5 0 10s-2.5 7.5 0 10" />
          <path d="M12 2c2.5 2.5 2.5 7.5 0 10s2.5 7.5 0 10" />
        </svg>
      </span>

      <span class="hero__decor-item hero__decor-item--telescope">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 3l9 3-9 3z" />
          <circle cx="18" cy="6" r="2" />
          <path d="M12 17h4" />
          <path d="M8 6v4" />
        </svg>
      </span>

      <span class="hero__decor-item hero__decor-item--computer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <rect x="4" y="4" width="16" height="11" rx="1" />
          <path d="M9 4v11" />
          <path d="M15 4v11" />
          <path d="M4 15h16" />
          <circle cx="12" cy="10" r="1.2" fill="currentColor" stroke="none" />
        </svg>
      </span>

      <span class="hero__decor-item hero__decor-item--book">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 5c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2H6z" />
          <path d="M6 12h12" />
          <path d="M6 8h8" />
          <path d="M6 16h8" />
        </svg>
      </span>
    </div>

    <div class="hero__logo-container">
      <div class="hero__orbit-center-glow"></div>

      <img
        class="hero__logo"
        src={withBase("/s2s-logo-no-background.png")}
        alt="Students 2 Science logo"
        width="464"
        height="538"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</div>