---
import { translatePay } from '../lib/data';
import { t, type Lang, type I18nKey } from '../i18n';

interface Props {
  annual?: number;
  label?: string;
  lang?: Lang;
}

const { annual, lang = 'en' } = Astro.props;
const label = Astro.props.label ?? t('pay.year', lang);
const pay = translatePay(annual);
// Whole dollars everywhere - cents make the boxes look messy.
const fmt = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
---

{
  pay && (
    <div class="pay">
      <p class="pay__lead">
        <strong>{fmt(annual ?? 0)}</strong> {label} {t('pay.lead1', lang)}{' '}
        <strong>{fmt(pay.hourly)} {t('pay.lead2', lang)}</strong>, {t('pay.lead3', lang)}{' '}
        <strong>{fmt(pay.weekly)} {t('pay.lead4', lang)}</strong>
      </p>
      <div class="pay__grid">
        <div class="pay__cell">
          <span class="pay__value">{fmt(pay.hourly)}</span>
          <span class="pay__label">{t('pay.perHour', lang)}</span>
        </div>
        <div class="pay__cell">
          <span class="pay__value">{fmt(pay.perDay)}</span>
          <span class="pay__label">{t('pay.perDay', lang)}</span>
        </div>
        <div class="pay__cell">
          <span class="pay__value">{fmt(pay.weekly)}</span>
          <span class="pay__label">{t('pay.perWeek', lang)}</span>
        </div>
        <div class="pay__cell">
          <span class="pay__value">{fmt(pay.monthly)}</span>
          <span class="pay__label">{t('pay.perMonth', lang)}</span>
        </div>
      </div>
      <p class="pay__note">{t('pay.thatIs', lang)} {t(pay.comparison as I18nKey, lang)}.</p>
    </div>
  )
}

<style>
  .pay {
    background: var(--paper-alt);
    border: var(--border);
    border-radius: var(--radius-m);
    padding: var(--space-m);
  }
  .pay__lead {
    margin: 0 0 var(--space-s);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  /* Always 2x2, so the four boxes stay even instead of orphaning one. */
  .pay__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xs);
  }
  .pay__cell {
    background: var(--paper);
    border: var(--border);
    border-radius: var(--radius-s);
    padding: var(--space-s);
    text-align: center;
    min-width: 0;
  }
  .pay__value {
    display: block;
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .pay__label {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-500);
    font-weight: 600;
  }
  .pay__note {
    margin: var(--space-s) 0 0;
    color: var(--ink-500);
    font-size: var(--step--1);
  }
</style>
