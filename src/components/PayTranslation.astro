---
import { translatePay } from '../lib/data';

interface Props {
  annual?: number;
  label?: string;
}

const { annual, label = 'a year' } = Astro.props;
const pay = translatePay(annual);
// Whole dollars everywhere - cents make the boxes look messy.
const fmt = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
---

{
  pay && (
    <div class="pay">
      <p class="pay__lead">
        <strong>{fmt(annual ?? 0)}</strong> {label} works out to about{' '}
        <strong>{fmt(pay.hourly)} an hour</strong>, or{' '}
        <strong>{fmt(pay.weekly)} a week</strong> before taxes.
      </p>
      <div class="pay__grid">
        <div class="pay__cell">
          <span class="pay__value">{fmt(pay.hourly)}</span>
          <span class="pay__label">per hour</span>
        </div>
        <div class="pay__cell">
          <span class="pay__value">{fmt(pay.perDay)}</span>
          <span class="pay__label">per day</span>
        </div>
        <div class="pay__cell">
          <span class="pay__value">{fmt(pay.weekly)}</span>
          <span class="pay__label">per week</span>
        </div>
        <div class="pay__cell">
          <span class="pay__value">{fmt(pay.monthly)}</span>
          <span class="pay__label">per month</span>
        </div>
      </div>
      <p class="pay__note">That is {pay.comparison}.</p>
    </div>
  )
}

<style>
  .pay {
    background: var(--paper-alt);
    border: var(--border);
    border-radius: var(--radius-m);
    padding: var(--space-m);
  }
  .pay__lead {
    margin: 0 0 var(--space-s);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  /* Always 2x2, so the four boxes stay even instead of orphaning one. */
  .pay__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xs);
  }
  .pay__cell {
    background: var(--paper);
    border: var(--border);
    border-radius: var(--radius-s);
    padding: var(--space-s);
    text-align: center;
    min-width: 0;
  }
  .pay__value {
    display: block;
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .pay__label {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-500);
    font-weight: 600;
  }
  .pay__note {
    margin: var(--space-s) 0 0;
    color: var(--ink-500);
    font-size: var(--step--1);
  }
</style>
