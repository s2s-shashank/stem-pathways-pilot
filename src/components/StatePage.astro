---
import { withBase } from '../lib/url';
import type { StateMeta } from '../data/states';
import { CATEGORIES } from '../data/states';
import { t, CATEGORY_LABELS_ES, type Lang, type I18nKey } from '../i18n';
import Bars from './Bars.astro';
import StatTile from './StatTile.astro';
import Explain from './Explain.astro';
import {
  getStateData,
  formatDate,
  formatMoney,
  formatNumber,
  formatGrowth,
  formatMetro,
  byEmployment,
  byCategory,
} from '../lib/data';

interface Props {
  state: StateMeta;
  lang?: Lang;
}

const { state, lang = 'en' } = Astro.props;
const catLabel = (id: string, en: string) =>
  lang === 'es' ? (CATEGORY_LABELS_ES[id] ?? en) : en;
const data = getStateData(state.code);
const has = Boolean(data);
const occ = data?.occupations ?? [];
const live = data?.live;
const priv = live?.private;

const topJobs = byEmployment(occ).slice(0, 8);
const topPay = [...occ]
  .filter((o) => o.employment >= 200)
  .sort((a, b) => b.meanWage - a.meanWage)
  .slice(0, 8);
const growing = [...occ]
  .filter((o) => typeof o.growth === 'number' && (o.growth ?? 0) > 0)
  .sort((a, b) => (b.growth ?? 0) - (a.growth ?? 0))
  .slice(0, 8);

const categoryGroups = byCategory(occ, CATEGORIES);
const fieldBars = categoryGroups
  .map((g) => ({
    label: catLabel(g.category.id, g.category.label),
    value: g.employment,
    color: g.category.color,
  }))
  .sort((a, b) => b.value - a.value);

const metroBars = Object.entries(data?.metros ?? {})
  .map(([title, value]) => {
    const { name, shared } = formatMetro(title);
    return { label: name, value, shared };
  })
  .sort((a, b) => b.value - a.value)
  .slice(0, 6);

const totalEmployment = occ.reduce((s, o) => s + o.employment, 0);
const medianAll =
  occ.length > 0
    ? occ.map((o) => o.medianWage).sort((a, b) => a - b)[Math.floor(occ.length / 2)]
    : undefined;

const liveBars = live
  ? CATEGORIES.map((c) => ({
      label: catLabel(c.id, c.label),
      value: live.byCategory[c.id] ?? 0,
      color: c.color,
    }))
      .filter((bar) => bar.value > 0)
      .sort((a, b) => b.value - a.value)
  : [];

const privateBars = priv
  ? CATEGORIES.map((c) => ({
      label: catLabel(c.id, c.label),
      value: priv.byCategory[c.id] ?? 0,
      color: c.color,
    }))
      .filter((bar) => bar.value > 0)
      .sort((a, b) => b.value - a.value)
  : [];
const cityBars = (priv?.topLocations ?? []).slice(0, 6).map((c) => ({
  label: c.name.replace(/,\s*[A-Z]{2}$/, ''),
  value: c.count,
  color: state.color,
}));
const employerBars = (priv?.topEmployers ?? []).slice(0, 6).map((c) => ({
  label: c.name,
  value: c.count,
  color: 'var(--c-data)',
}));

const SOURCE_NOTES: Record<string, I18nKey> = {
  USAJOBS: 'sp.note.usajobs',
  'NJ Civil Service': 'sp.note.njcivil',
  StateJobsNY: 'sp.note.ny',
  'Commonwealth Careers': 'sp.note.pa',
  CareerOneStop: 'sp.note.cos',
};
---

<section class="state-hero" style={`--accent:${state.color}`}>
  <div class="wrap">
    <span class="hero__tag">
      <span aria-hidden="true">●</span> {state.abbr} {t('sp.tag', lang)}
    </span>
    <h1>{t('sp.h1', lang)} {state.name}</h1>
    <p class="lede">{t(`state.${state.code}.blurb` as const, lang)}</p>
    {data && <p class="stamp">{t('sp.asOf', lang)} {formatDate(data.asOf, lang)}</p>}
    {lang === 'es' && <p class="stamp">{t('es.notice', lang)}</p>}
  </div>
</section>

{
  !has ? (
    <section class="section">
      <div class="wrap wrap--narrow">
        <h2>{t('sp.noData.h2', lang)}</h2>
        <p class="lede">{t('sp.noData.p', lang, { state: state.name })}</p>
        <p>
          <a class="btn btn--primary" href={withBase('/sources')}>
            {t('sp.noData.cta', lang)}
          </a>
        </p>
      </div>
    </section>
  ) : (
    <>
      <section class="section section--tight">
        <div class="wrap">
          <div class="grid grid--2">
            <StatTile
              accent
              value={formatNumber(totalEmployment)}
              label={t('sp.stat1.label', lang)}
              note={t('sp.stat1.note', lang)}
            />
            <StatTile
              value={formatNumber(priv?.total)}
              label={t('sp.stat2.label', lang)}
              note={t('sp.stat2.note', lang)}
            />
            <StatTile
              value={formatNumber(live?.total)}
              label={t('sp.stat3.label', lang)}
              note={t('sp.stat3.note', lang)}
            />
            <StatTile
              value={formatMoney(medianAll)}
              label={t('sp.stat4.label', lang)}
              note={t('sp.stat4.note', lang)}
            />
          </div>
        </div>
      </section>

      <section class="section section--tight">
        <div class="wrap wrap--narrow">
          <div class="card start-card">
            <h2 class="card__title">{t('sp.read.h2', lang)}</h2>
            <p>{t('sp.read.p', lang)}</p>
            <ul class="start-list">
              <li>
                <strong>{t('sp.read.1a', lang)}</strong>{t('sp.read.1b', lang)}
              </li>
              <li>
                <strong>{t('sp.read.2a', lang)}</strong>{t('sp.read.2b', lang)}
              </li>
              <li>
                <strong>{t('sp.read.3a', lang)}</strong>{t('sp.read.3b', lang)}
              </li>
            </ul>
          </div>
        </div>
      </section>

      <section class="section section--alt">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{t('sp.fields.eyebrow', lang)}</span>
            <h2>{t('sp.fields.h2', lang)}</h2>
            <p class="lede">{t('sp.fields.lede', lang, { state: state.name })}</p>
          </div>
          <div class="card">
            <Bars
              items={fieldBars}
              label={t('sp.fields.label', lang, { state: state.name })}
              suffix={t('sp.suffix.people', lang)}
            />
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{t('sp.private.eyebrow', lang)}</span>
            <h2>{t('sp.private.h2', lang, { state: state.name })}</h2>
            <p class="lede">{t('sp.private.lede', lang)}</p>
          </div>
          {priv && priv.total > 0 ? (
            <>
              <div class="grid grid--2">
                <div class="card">
                  <h3 class="card__title">{t('sp.private.byField', lang)}</h3>
                  <Bars
                    items={privateBars}
                    label={t('sp.private.byFieldLabel', lang, { state: state.name })}
                    suffix={t('sp.suffix.posting', lang)}
                  />
                  <p class="source-note">
                    {t('sp.private.note', lang, { count: formatNumber(priv.total) })}
                  </p>
                </div>
                <div class="card">
                  <h3 class="card__title">{t('sp.private.where', lang)}</h3>
                  <Bars
                    items={cityBars}
                    label={t('sp.private.whereLabel', lang, { state: state.name })}
                    suffix={t('sp.suffix.posting', lang)}
                  />
                </div>
              </div>
              {employerBars.length > 0 && (
                <div class="card top-employers">
                  <h3 class="card__title">{t('sp.private.who', lang)}</h3>
                  <Bars
                    items={employerBars}
                    label={t('sp.private.whoLabel', lang, { state: state.name })}
                    suffix={t('sp.suffix.posting', lang)}
                  />
                </div>
              )}
            </>
          ) : (
            <div class="card">
              <p class="muted">{t('sp.private.none', lang)}</p>
            </div>
          )}
        </div>
      </section>

      <section class="section section--alt">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{t('sp.gov.eyebrow', lang)}</span>
            <h2>{t('sp.gov.h2', lang)}</h2>
            <p class="lede">{t('sp.gov.lede', lang)}</p>
          </div>
          <div class="split">
            <div class="card">
              <Bars
                items={liveBars}
                label={t('sp.gov.label', lang, { state: state.name })}
                suffix={t('sp.suffix.job', lang)}
              />
              <table class="sources-table">
                <caption class="sr-only">{t('sp.gov.caption', lang)}</caption>
                <thead>
                  <tr>
                    <th scope="col">{t('sp.gov.source', lang)}</th>
                    <th scope="col" class="num">{t('sp.gov.count', lang)}</th>
                  </tr>
                </thead>
                <tbody>
                  {(live?.sources ?? [])
                    .filter((source) => source.kind !== 'search')
                    .map((source) => (
                      <tr>
                        <th scope="row">
                          <a href={source.url} rel="noopener">
                            {source.name}
                          </a>
                          <span class="source-note">{SOURCE_NOTES[source.name] ? t(SOURCE_NOTES[source.name], lang) : ''}</span>
                        </th>
                        <td class="num">{formatNumber(source.count)}</td>
                      </tr>
                    ))}
                </tbody>
              </table>
            </div>
            <div class="card">
              <h3 class="card__title">{t('sp.gov.examples', lang)}</h3>
              <ul class="postings">
                {(live?.postings ?? []).slice(0, 8).map((p) => (
                  <li class="posting">
                    <a class="posting__title" href={p.url} rel="noopener">
                      {p.title}
                    </a>
                    <span class="posting__meta">
                      {p.employer}
                      {p.location ? ` · ${p.location}` : ''}
                      {p.salaryMin && p.salaryMax
                        ? ` · ${formatMoney(p.salaryMin)}–${formatMoney(p.salaryMax)}`
                        : ''}
                    </span>
                  </li>
                ))}
              </ul>
              {live?.postings.length === 0 && <p class="muted">{t('sp.gov.none', lang)}</p>}
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{t('sp.common.eyebrow', lang)}</span>
            <h2>{t('sp.common.h2', lang)}</h2>
            <p class="lede">{t('sp.common.lede', lang)}</p>
          </div>
          <div class="card">
            <Bars
              items={topJobs.map((o) => ({
                label: o.title,
                value: o.employment,
                href: `/careers/${o.soc}`,
              }))}
              label={t('sp.common.label', lang, { state: state.name })}
              suffix={t('sp.suffix.people', lang)}
            />
          </div>
        </div>
      </section>

      <section class="section section--alt">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{t('sp.pay.eyebrow', lang)}</span>
            <h2>{t('sp.pay.h2', lang)}</h2>
            <p class="lede">{t('sp.pay.lede', lang, { state: state.name })}</p>
          </div>
          <div class="card">
            <Bars
              items={topPay.map((o) => ({
                label: o.title,
                value: o.meanWage,
                color: state.color,
                href: `/careers/${o.soc}`,
              }))}
              label={t('sp.pay.label', lang, { state: state.name })}
              format="currency"
            />
            <p class="source-note">
              {t('sp.pay.note1', lang)}{' '}
              <a href={withBase('/careers')}>{t('sp.pay.note2', lang)}</a>{' '}
              {t('sp.pay.note3', lang)}
            </p>
          </div>
        </div>
      </section>

      {metroBars.length > 0 && (
        <section class="section">
          <div class="wrap">
            <div class="section-head">
              <span class="eyebrow">{t('sp.metro.eyebrow', lang)}</span>
              <h2>{t('sp.metro.h2', lang)}</h2>
              <p class="lede">{t('sp.metro.lede', lang)}</p>
            </div>
            <div class="card">
              <Bars
                items={metroBars.map((m) => ({
                  label: m.label,
                  value: m.value,
                  color: state.color,
                }))}
                label={t('sp.metro.label', lang, { state: state.name })}
                suffix={t('sp.suffix.people', lang)}
              />
              <ul class="metro-shared">
                {metroBars
                  .filter((m) => m.shared.length > 0)
                  .map((m) => (
                    <li>
                      <strong>{m.label}</strong> {t('sp.metro.also', lang)} {m.shared.join(', ')}
                    </li>
                  ))}
              </ul>
            </div>
          </div>
        </section>
      )}

      {growing.length > 0 && (
        <section class="section section--alt">
          <div class="wrap">
            <div class="section-head">
              <span class="eyebrow">{t('sp.growth.eyebrow', lang)}</span>
              <h2>{t('sp.growth.h2', lang)}</h2>
              <p class="lede">{t('sp.growth.lede', lang)}</p>
            </div>
            <div class="card">
              <Bars
                items={growing.map((o) => ({
                  label: o.title,
                  value: o.growth ?? 0,
                  display: formatGrowth(o.growth),
                  color: 'var(--c-good)',
                }))}
                label={t('sp.growth.label', lang, { state: state.name })}
                format="percent"
              />
              <p class="source-note">{t('sp.growth.note', lang)}</p>
            </div>
          </div>
        </section>
      )}

      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{t('sp.deeper.eyebrow', lang)}</span>
            <h2>{t('sp.deeper.h2', lang)}</h2>
            <p class="lede">{t('sp.deeper.lede', lang, { state: state.name })}</p>
          </div>
          <div class="grid grid--3">
            {categoryGroups.map((g) => (
              <article class="card card--flat" style={`--accent:${g.category.color}`}>
                <div class="cat__icon" aria-hidden="true">
                  {g.category.icon}
                </div>
                <h3 class="card__title">{catLabel(g.category.id, g.category.label)}</h3>
                <p class="muted">
                  {formatNumber(g.employment)} {t('sp.deeper.workIn', lang)}{' '}
                  {state.abbr}.
                </p>
                <ul class="career-links">
                  {g.occupations.slice(0, 6).map((o) => (
                    <li>
                      <a href={withBase(`/careers/${o.soc}`)}>{o.title}</a>
                      <span class="muted"> · {formatMoney(o.meanWage)}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>
    </>
  )
}

<style>
  .state-hero {
    background:
      radial-gradient(
        900px 380px at 12% -20%,
        color-mix(in srgb, var(--accent) 45%, transparent) 0%,
        transparent 62%
      ),
      var(--navy-900);
    color: #eaf0fb;
    padding-block: var(--space-2xl);
  }
  .state-hero h1 {
    color: #fff;
  }
  .state-hero .lede {
    color: #b9c8e0;
  }

  .start-card {
    border-left: 5px solid var(--accent);
  }
  .start-list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-700);
  }
  .start-list li + li {
    margin-top: 0.6rem;
  }

  .split {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    align-items: start;
  }

  .postings {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posting {
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--paper-sunk);
  }
  .posting:last-child {
    border-bottom: 0;
  }
  .posting__title {
    display: block;
    font-weight: 700;
    text-decoration: none;
  }
  .posting__title:hover {
    text-decoration: underline;
  }
  .posting__meta {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-500);
  }

  .cat__icon {
    font-size: 1.75rem;
    line-height: 1;
    margin-bottom: var(--space-2xs);
  }

  .career-links {
    list-style: none;
    padding: 0;
    margin: var(--space-s) 0 0;
    font-size: var(--step--1);
  }
  .career-links li + li {
    margin-top: 0.3rem;
  }

  .sources-table {
    margin-top: var(--space-m);
    font-size: var(--step--1);
  }
  .sources-table thead th {
    padding: 0.4rem 0.6rem;
  }
  .sources-table th,
  .sources-table td {
    padding: 0.5rem 0.6rem;
  }
  .sources-table .source-note {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--step--1);
    color: var(--ink-500);
  }

  .top-employers {
    margin-top: var(--space-m);
  }

  .metro-shared {
    list-style: none;
    margin: var(--space-s) 0 0;
    padding: 0;
    font-size: var(--step--1);
    color: var(--ink-500);
  }
  .metro-shared li + li {
    margin-top: 0.25rem;
  }
</style>
