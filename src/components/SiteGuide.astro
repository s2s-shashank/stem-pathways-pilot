---
/**
 * "How to browse this site" guide.
 *
 * One simple panel that shows the structure of the website with links to
 * every section. Opens itself once on the home page, and any time the "?"
 * button in the header is clicked (any element with data-open-guide).
 */
import { withBase } from '../lib/url';
import { t, type Lang } from '../i18n';

interface Props {
  /** Open by itself on load. Only the home page does this, and only once. */
  autoOpen?: boolean;
  lang?: Lang;
}

const { autoOpen = false, lang = 'en' } = Astro.props;

const sections = [
  {
    title: t('nav.states', lang),
    blurb: t('guide.states.blurb', lang),
    links: [
      { label: 'New Jersey', url: '/nj' },
      { label: 'New York', url: '/ny' },
      { label: 'Pennsylvania', url: '/pa' },
      { label: t('nav.compareAll', lang), url: '/compare' },
    ],
  },
  {
    title: 'Labs2Life',
    blurb: t('guide.labs.blurb', lang),
    links: [{ label: t('guide.labs.link', lang), url: '/labs2life' }],
  },
  {
    title: t('guide.careers.title', lang),
    blurb: t('guide.careers.blurb', lang),
    links: [
      { label: t('guide.careers.browse', lang), url: '/careers' },
      { label: t('guide.careers.glossary', lang), url: '/glossary' },
    ],
  },
  {
    title: t('guide.tools.title', lang),
    blurb: t('guide.tools.blurb', lang),
    links: [
      { label: t('guide.tools.explore', lang), url: '/explore' },
      { label: t('guide.tools.quiz', lang), url: '/quiz' },
      { label: t('guide.tools.sources', lang), url: '/sources' },
    ],
  },
  {
    title: t('nav.aboutS2S', lang),
    blurb: t('guide.about.blurb', lang),
    links: [
      { label: t('guide.about.about', lang), url: '/about' },
      { label: t('guide.about.cap', lang), url: '/cap-program' },
    ],
  },
];
---

<div
  class="guide"
  id="guide"
  hidden
  data-auto-open={autoOpen ? 'true' : 'false'}
  role="dialog"
  aria-modal="true"
  aria-label={t('guide.title', lang)}
>
  <div class="guide__scrim" data-close></div>

  <div class="guide__panel" role="document">
    <header class="guide__head">
      <div class="guide__brand">
        <span aria-hidden="true">🧭</span>
        <span>{t('guide.title', lang)}</span>
      </div>
      <button
        type="button"
        class="guide__x"
        data-close
        aria-label={t('guide.close', lang)}
      >
        ✕
      </button>
    </header>

    <div class="guide__body">
      <p class="guide__lede">
        {t('guide.lede', lang)}
      </p>

      {
        sections.map((s) => (
          <section class="guide__section">
            <h2 class="guide__title">{s.title}</h2>
            <p class="guide__blurb">{s.blurb}</p>
            <p class="guide__links">
              {s.links.map((l, i) => (
                <>
                  {i > 0 && <span aria-hidden="true" class="guide__sep">·</span>}
                  <a class="guide__link" href={withBase(l.url)}>
                    {l.label}
                  </a>
                </>
              ))}
            </p>
          </section>
        ))
      }
    </div>
  </div>
</div>

<script>
  const root = document.getElementById('guide');
  let lastFocused: HTMLElement | null = null;

  function open() {
    if (!root) return;
    lastFocused = document.activeElement as HTMLElement;
    root.hidden = false;
    document.body.classList.add('guide-open');
    requestAnimationFrame(() => {
      root.querySelector<HTMLElement>('.guide__x')?.focus();
    });
  }

  function close() {
    if (!root) return;
    root.hidden = true;
    document.body.classList.remove('guide-open');
    lastFocused?.focus?.();
  }

  root?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-close]')) close();
  });

  document.addEventListener('keydown', (e) => {
    if (!root || root.hidden) return;
    if (e.key === 'Escape') {
      close();
      return;
    }
    if (e.key === 'Tab') {
      // Keep Tab inside the dialog while it is open.
      const focusable = Array.from(
        root.querySelectorAll<HTMLElement>(
          'button:not([disabled]), a[href]',
        ),
      ).filter((el) => el.offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement as HTMLElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // The "?" button in the header opens the guide from any page.
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-open-guide]')) open();
  });

  // Open itself once, on the home page only, per browser. After the logo
  // glides in from the password page, wait for that to finish first.
  if (root?.dataset.autoOpen === 'true') {
    const SEEN_KEY = 'stempathways:guide-seen';
    const openAfterArrival = () => {
      if (document.documentElement.hasAttribute('data-from-gate')) {
        setTimeout(open, 1000);
      } else {
        open();
      }
    };
    try {
      if (!localStorage.getItem(SEEN_KEY)) {
        localStorage.setItem(SEEN_KEY, '1');
        openAfterArrival();
      }
    } catch {
      // Private mode - just open it.
      openAfterArrival();
    }
  }
</script>

<style>
  .guide {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: var(--space-s);
  }

  /* display:grid above would otherwise beat the hidden attribute. */
  .guide[hidden] {
    display: none;
  }

  .guide__scrim {
    position: absolute;
    inset: 0;
    background: rgb(11 18 32 / 62%);
    backdrop-filter: blur(4px);
    animation: guide-fade 0.2s ease;
  }

  .guide__panel {
    position: relative;
    width: min(100%, 46rem);
    max-height: min(92vh, 54rem);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--ink-900);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-l);
    animation: guide-pop 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }

  .guide__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s) var(--space-m);
    border-bottom: 1px solid var(--paper-sunk);
  }

  .guide__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .guide__x {
    font: inherit;
    font-size: 1rem;
    line-height: 1;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--paper-sunk);
    background: var(--paper);
    color: var(--ink-500);
    cursor: pointer;
  }

  .guide__x:hover {
    background: var(--paper-alt);
    color: var(--ink-900);
  }

  .guide__body {
    flex: 1;
    overflow-y: auto;
    padding: 0 var(--space-m) var(--space-s);
  }

  .guide__lede {
    color: var(--ink-700);
    margin: var(--space-m) 0 var(--space-2xs);
  }

  .guide__section {
    border-top: 1px solid var(--paper-sunk);
    padding-top: 0.55rem;
    margin-top: 0.55rem;
  }

  .guide__title {
    font-size: var(--step-0);
    margin: 0 0 0.15rem;
  }

  .guide__blurb {
    margin: 0 0 0.3rem;
    color: var(--ink-500);
    font-size: var(--step--1);
  }

  .guide__links {
    margin: 0;
  }

  .guide__link {
    font-weight: 600;
    font-size: var(--step--1);
  }

  .guide__sep {
    margin-inline: 0.45rem;
    color: var(--ink-300);
  }

  :global(body.guide-open) {
    overflow: hidden;
  }

  @keyframes guide-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes guide-pop {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
  }

  @media (max-width: 560px) {
    .guide__panel {
      max-height: 94vh;
      border-radius: var(--radius-m);
    }
    .guide__body {
      padding-inline: var(--space-s);
    }
  }
</style>
