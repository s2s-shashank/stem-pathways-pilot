---
/**
 * "How to browse this site" guide.
 *
 * One simple panel that shows the structure of the website with links to
 * every section. Opens itself once on the home page, and any time the "?"
 * button in the header is clicked.
 */
import { withBase } from '../lib/url';

interface Props {
  /** Open by itself on load. Only the home page does this, and only once. */
  autoOpen?: boolean;
}

const { autoOpen = false } = Astro.props;

const sections = [
  {
    title: 'States',
    blurb: 'Job counts, pay and openings for each state.',
    links: [
      { label: 'New Jersey', url: '/nj' },
      { label: 'New York', url: '/ny' },
      { label: 'Pennsylvania', url: '/pa' },
      { label: 'Compare all three', url: '/compare' },
    ],
  },
  {
    title: 'Labs2Life',
    blurb: 'S2S labs and the careers behind each experiment.',
    links: [{ label: 'From lab to career', url: '/labs2life' }],
  },
  {
    title: 'Careers',
    blurb: 'Every STEM job: what it pays, openings, what to study.',
    links: [
      { label: 'Browse all careers', url: '/careers' },
      { label: 'Glossary of terms', url: '/glossary' },
    ],
  },
  {
    title: 'Tools',
    blurb: 'Play with the numbers and see where they come from.',
    links: [
      { label: 'Quiz: guess the salary', url: '/quiz' },
      { label: 'Sources & data notes', url: '/sources' },
    ],
  },
  {
    title: 'About S2S',
    blurb: 'Who we are and how we help students reach STEM careers.',
    links: [
      { label: 'About Students 2 Science', url: '/about' },
      { label: 'Career Advancement Program', url: '/cap-program' },
    ],
  },
];
---

<div
  class="finder guide"
  id="finder"
  hidden
  data-state="closed"
  data-auto-open={autoOpen ? 'true' : 'false'}
  role="dialog"
  aria-modal="true"
  aria-label="How to Browse This Site"
>
  <div class="finder__scrim" data-close></div>

  <div class="finder__panel" role="document">
    <header class="finder__head">
      <div class="finder__brand">
        <span class="finder__spark" aria-hidden="true">🧭</span>
        <span>How to Browse This Site</span>
      </div>
      <button
        type="button"
        class="finder__x"
        data-close
        aria-label="Close the guide"
      >
        ✕
      </button>
    </header>

    <div class="finder__viewport guide__body">
      <p class="finder__lede">
        Here's everything on the site, in one place.
      </p>

      {
        sections.map((s) => (
          <section class="guide__section">
            <h2 class="guide__title">{s.title}</h2>
            <p class="guide__blurb">{s.blurb}</p>
            <p class="guide__links">
              {s.links.map((l, i) => (
                <>
                  {i > 0 && <span aria-hidden="true" class="guide__sep">·</span>}
                  <a class="guide__link" href={withBase(l.url)}>
                    {l.label}
                  </a>
                </>
              ))}
            </p>
          </section>
        ))
      }
    </div>
  </div>
</div>

<script>
  const root = document.getElementById('finder');
  let lastFocused: HTMLElement | null = null;

  function open() {
    if (!root) return;
    lastFocused = document.activeElement as HTMLElement;
    root.hidden = false;
    root.dataset.state = 'open';
    document.body.classList.add('finder-open');
    requestAnimationFrame(() => {
      root.querySelector<HTMLElement>('.finder__x')?.focus();
    });
  }

  function close() {
    if (!root) return;
    root.hidden = true;
    root.dataset.state = 'closed';
    document.body.classList.remove('finder-open');
    lastFocused?.focus?.();
  }

  root?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-close]')) close();
  });

  document.addEventListener('keydown', (e) => {
    if (!root || root.hidden) return;
    if (e.key === 'Escape') {
      close();
      return;
    }
    if (e.key === 'Tab') {
      // Keep Tab inside the dialog while it is open.
      const focusable = Array.from(
        root.querySelectorAll<HTMLElement>(
          'button:not([disabled]), a[href]',
        ),
      ).filter((el) => el.offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement as HTMLElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // The "?" button in the header opens the guide from any page.
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-open-finder]')) open();
  });

  // Open itself once, on the home page only, per browser.
  if (root?.dataset.autoOpen === 'true') {
    const SEEN_KEY = 'stempathways:guide-seen';
    try {
      if (!localStorage.getItem(SEEN_KEY)) {
        localStorage.setItem(SEEN_KEY, '1');
        open();
      }
    } catch {
      // Private mode - just open it.
      open();
    }
  }
</script>

<style>
  .guide__body {
    padding-block: 0 var(--space-s);
  }
  .guide__body .finder__lede {
    margin-bottom: var(--space-2xs);
  }
  .guide__section {
    border-top: 1px solid var(--paper-sunk);
    padding-top: 0.55rem;
    margin-top: 0.55rem;
  }
  .guide__title {
    font-size: var(--step-0);
    margin: 0 0 0.15rem;
  }
  .guide__blurb {
    margin: 0 0 0.3rem;
    color: var(--ink-500);
    font-size: var(--step--1);
  }
  .guide__links {
    margin: 0;
  }
  .guide__link {
    font-weight: 600;
    font-size: var(--step--1);
  }
  .guide__sep {
    margin-inline: 0.45rem;
    color: var(--ink-300);
  }
</style>
